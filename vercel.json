{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "designsystem.alexendros.dev"
        }
      ],
      "destination": "/design-system/"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "designsystem.alexendros.dev"
        }
      ],
      "destination": "/design-system/"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.alexendros.dev"
        }
      ],
      "destination": "https://alexendros.dev/:path*",
      "permanent": true
    },
    {
      "source": "/design-system",
      "has": [
        {
          "type": "host",
          "value": "designsystem.alexendros.dev"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/design-system/",
      "has": [
        {
          "type": "host",
          "value": "designsystem.alexendros.dev"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/metodo",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/metodo/",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/valores",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/valores/",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/como-trabajo",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/como-trabajo/",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/proceso-y-entrega",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/proceso-y-entrega/",
      "destination": "/metodologia",
      "permanent": true
    },
    {
      "source": "/proyectos",
      "destination": "/referencias",
      "permanent": true
    },
    {
      "source": "/proyectos/",
      "destination": "/referencias",
      "permanent": true
    },
    {
      "source": "/proyectos/:path*",
      "destination": "/referencias/:path*",
      "permanent": true
    },
    {
      "source": "/aviso-legal",
      "destination": "/identidad",
      "permanent": true
    },
    {
      "source": "/afiliados",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicios/produccion-sitios-web",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/auditorias",
      "destination": "/servicios/",
      "permanent": true
    },
    {
      "source": "/servicios/consultoria-tecnologica",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/landing-10-dias",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/sesion-profesional",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/sesion-profesional/",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/auditoria-normativa-ciberseguridad",
      "destination": "/servicios/",
      "permanent": true
    },
    {
      "source": "/servicios/auditoria-normativa-ciberseguridad/",
      "destination": "/servicios/",
      "permanent": true
    },
    {
      "source": "/servicios/web-para",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/web-para/:path*",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/informe-comercial",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/servicios/informe-comercial/",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/servicios/cumplimiento-normativo",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/servicios/cumplimiento-normativo/",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/servicios/ciberseguridad",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/servicios/ciberseguridad/",
      "destination": "/servicios/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com 'sha256-ar8Uiqw7CwJ04XkJlXTKrUkGfZnTf2kIB9UHvq6jXlk='; style-src 'self' 'sha256-9qkeeguVJuk8mjM0U8m7RCq/UaKGhE9iZ/BzD0hxbVA='; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com 'sha256-ar8Uiqw7CwJ04XkJlXTKrUkGfZnTf2kIB9UHvq6jXlk='; style-src 'self' 'sha256-9qkeeguVJuk8mjM0U8m7RCq/UaKGhE9iZ/BzD0hxbVA='; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report/; report-to csp-endpoint"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_image(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": true
}
