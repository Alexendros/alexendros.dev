{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexendros.dev/schemas/audits/record.schema.json",
  "title": "Alexendros.dev audit record collection",
  "description": "Colección tipada de decisiones o eventos operativos con orden de escritura y flag active.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "items"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": ["decisions", "events"]
    },
    "items": {
      "type": "array",
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "decisions" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/decisionItem" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "events" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/eventItem" }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestampCanon": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "ISO-8601 UTC canónico YYYY-MM-DDTHH:mm:ssZ"
    },
    "decisionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "timestamp",
        "active",
        "title",
        "summary",
        "recordType",
        "status",
        "supersedes",
        "supersededBy",
        "context",
        "decision",
        "consequences"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/$defs/timestampCanon" },
        "active": {
          "type": "boolean",
          "description": "true = decisión vigente; false = solo referencia"
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "recordType": { "const": "decision" },
        "status": {
          "type": "string",
          "enum": ["aceptada", "superseded"]
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "supersededBy": { "type": ["string", "null"] },
        "context": { "type": "string" },
        "decision": { "type": "string" },
        "consequences": { "type": "string" }
      }
    },
    "eventItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "timestamp",
        "active",
        "title",
        "summary",
        "recordType",
        "kind",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "$ref": "#/$defs/timestampCanon" },
        "active": {
          "type": "boolean",
          "description": "true = hay que actuar; false = solo referencia"
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "recordType": { "const": "event" },
        "kind": {
          "type": "string",
          "enum": ["alerta", "aviso"],
          "description": "alerta = roto; aviso = no-roto"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Ruta antigua del acta o URL de issue"
        }
      }
    }
  }
}
