---
import sourceSansLatinUrl from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkipLink from '../components/SkipLink.astro';
import { site } from '../content/site';
import { profile } from '../content/profile';
import { THEME_BG_LIGHT, THEME_BG_DARK } from '../lib/themeColors';
import paletteCss from '../styles/design-references.css?raw';
function paletteColor(property: string): string {
  const value = paletteCss.match(new RegExp(`${property}:\\s*([^;]+);`))?.[1];
  if (!value) throw new Error(`Falta ${property} en la paleta Atlaps`);
  return value;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = site.titleDefault,
  description = site.descriptionDefault,
  ogImage = '/og/default.png',
  ogImageAlt,
  robots,
  canonical: canonicalPath,
  jsonLd
} = Astro.props;
const resolvedOgAlt = ogImageAlt ?? title;
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const pathname = Astro.url.pathname;
const canonical = new URL(canonicalPath ?? pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#persona`,
      name: profile.name,
      alternateName: profile.alternateName,
      jobTitle: profile.jobTitle,
      description: profile.summary,
      url: site.url,
      sameAs: [site.social.github, site.social.linkedin],
      email: 'contratacion@alexendros.dev',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Valencia',
        addressCountry: 'ES'
      }
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#alexendros`,
      name: 'Alexendros',
      founder: { '@id': `${site.url}/#persona` },
      description: site.descriptionDefault,
      url: site.url,
      email: 'contratacion@alexendros.dev',
      areaServed: { '@type': 'City', name: 'Valencia' },
      knowsAbout: [
        'auditoría técnica SEO',
        'privacidad, cookies y accesibilidad web',
        'seguridad web básica',
        'colaboración en proyectos de programación',
        'sitios web profesionales',
        'integración de catálogo y pagos'
      ],
      sameAs: [site.social.github, site.social.linkedin],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Valencia',
        addressCountry: 'ES'
      }
    },
    ...extraJsonLd
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="preload" href={sourceSansLatinUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content={paletteColor(THEME_BG_LIGHT)}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={paletteColor(THEME_BG_DARK)}
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:image:alt" content={resolvedOgAlt} />
    <Fragment set:html={'<script src="/theme-init.js"></script>'} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <!-- Sin fondo propio en body: la rejilla vive en body::before (global.css)
       y el color de página lo pinta :root (daisyUI, base-100 = base-200). -->
  <body class="text-base-content antialiased min-h-screen flex flex-col">
    <SkipLink />
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initTracking } from '../lib/tracking/loaders';
      import { setupFunnelTracking } from '../lib/tracking/events';
      import { captureReferralFromLocation } from '../lib/referral';
      import { initCookieBanner } from '../scripts/cookieBanner';
      initTracking();
      setupFunnelTracking();
      captureReferralFromLocation();
      initCookieBanner();
    </script>
  </body>
</html>
