---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Container from '../../components/Container.astro';
import Grid from '../../components/Grid.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../content/projects';
---

<Layout
  title="Trabajos realizados — Alexendros"
  description="Trabajos realizados íntegramente por mí: referencias reales y base para solicitar un producto similar para tu negocio o proyecto."
>
  <Container class="py-16 md:py-24">
    <PageHead
      title="Trabajos realizados"
      description="Estos trabajos los realicé íntegramente yo. Sirven como referencias reales y también para pedir un producto similar para tu negocio o proyecto. En cada obra verás el punto de partida, lo que se hizo, qué cambió y si está disponible."
    />
    <Grid gap="6" class="mt-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <div data-reveal style={`--i:${i}`}>
            <ProjectCard project={p} priority={i === 0} />
          </div>
        ))
      }
    </Grid>
  </Container>
</Layout>
