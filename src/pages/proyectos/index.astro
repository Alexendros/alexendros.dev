---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import Grid from '../../components/Grid.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DetailIsland from '../../components/DetailIsland.astro';
import { availabilityCtaLabels, productTypeLabels, projects } from '../../content/projects';

const detailItems = projects.map((p) => ({
  slug: p.slug,
  path: `/proyectos/${p.slug}`,
  title: p.title,
  short: p.short,
  description: p.summary,
  meta: productTypeLabels[p.productType],
  ctaLabel: availabilityCtaLabels[p.availability],
  ctaHref: `/contacto?motivo=informacionCliente&proyecto=${p.slug}&origen=proyectos`
}));
---

<Layout
  title="Proyectos realizados — Alexendros"
  description="Proyectos profesionales cumplidos con el criterio de Alexendros.dev."
  ogImage="/og/proyectos.png"
  ogImageAlt="Proyectos profesionales cumplidos con el criterio de Alexendros.dev"
>
  <Container class="py-16 md:py-24">
    <header>
      <h1 class="text-step-3 break-words font-bold max-w-3xl text-balance">
        Proyectos profesionales cumplidos{' '}
        <span class="text-primary">con el criterio de Alexendros.dev</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
    </header>
    <Grid gap="6" class="mt-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <div data-reveal={i >= 3 || undefined} style={i >= 3 ? `--i:${i - 3}` : undefined}>
            <ProjectCard project={p} priority={i === 0} />
          </div>
        ))
      }
    </Grid>
    <DetailIsland basePath="/proyectos" items={detailItems} />
  </Container>
</Layout>
