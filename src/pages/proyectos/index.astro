---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Container from '../../components/Container.astro';
import Grid from '../../components/Grid.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../content/projects';
---

<Layout
  title="Proyectos realizados — Alexendros"
  description="Trabajos que he hecho yo, de principio a fin."
  ogImage="/og/proyectos.png"
  ogImageAlt="Casos reales de Alexendros.dev"
>
  <Container class="py-16 md:py-24">
    <PageHead
      title="Proyectos realizados"
      description="Trabajos que he hecho yo, de principio a fin."
    />
    <Grid gap="6" class="mt-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <div data-reveal style={`--i:${i}`}>
            <ProjectCard project={p} priority={i === 0} />
          </div>
        ))
      }
    </Grid>
  </Container>
</Layout>
