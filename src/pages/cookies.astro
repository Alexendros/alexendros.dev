---
import Layout from '../layouts/Layout.astro';
import { seoForPath } from '../content/seo';
import { breadcrumbFromHome } from '../lib/breadcrumb';
import inventory from '../../docs/cookies-inventory.json';
import { PROCESSORS } from '../content/processors';
import { formatDateEs } from '../lib/formatDateEs';

const seo = seoForPath('/cookies/');
const COOKIES_CONTACT_EMAIL = 'datos@alexendros.dev';

type InventoryCookie = {
  name: string;
  owner: string;
  purpose: string;
  duration: string;
  label: string;
  requiresConsent: boolean;
  party?: string;
};

const cookies = inventory.cookies as InventoryCookie[];
const analyticsProcessors = PROCESSORS.filter((p) => p.kind === 'analytics');
const updatedAt = inventory.updatedAt as string;
const updatedAtLabel = formatDateEs(updatedAt);

function ownerCell(cookie: InventoryCookie): string {
  if (cookie.party === 'first' && cookie.owner === 'alexendros.dev') {
    return 'alexendros.dev (primera parte)';
  }
  if (cookie.party === 'third') return `${cookie.owner} (tercero)`;
  return cookie.owner;
}
---

<Layout
  title={seo.title}
  description={seo.description}
  jsonLd={breadcrumbFromHome({ name: 'Cookies', path: '/cookies/' })}
>
  <div class="page-shell page-shell-narrow legal-prose">
    <p class="font-mono">LEGAL</p>
    <h1>Cookies</h1>
    <p>
      El navegador guarda tu elección de privacidad y, si cambias el tema, tu preferencia visual.
    </p>
    <p>La medición de visitas y rendimiento solo se activa con tu permiso.</p>

    <p id="preferencias" class="mt-4">
      <button
        type="button"
        data-cc="show-preferencesModal"
        class="btn inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-6 py-3 font-medium hover:border-primary hover:text-primary focus-ring"
      >
        Configurar
      </button>
    </p>
    <p class="text-sm text-muted">Abre el panel con interruptores por categoría.</p>
    <p class="text-sm text-muted">
      «Aceptar todas» enciende la analítica. «Rechazar opcionales» deja solo lo técnico.
    </p>

    <h2>Almacenamiento necesario</h2>
    {
      cookies.map((cookie) => (
        <section data-cookie-name={cookie.name}>
          <h3>
            <code>{cookie.name}</code>
          </h3>
          <p>{cookie.purpose}</p>
          <p>
            Cookie de {ownerCell(cookie)}. Duración: {cookie.duration}.
          </p>
        </section>
      ))
    }
    <h3>Preferencia de tema</h3>
    <p>
      Si eliges un tema claro u oscuro, el sitio guarda la clave <code>theme</code> en el almacenamiento
      local. Se elimina al volver al tema del sistema o borrar los datos del sitio.
    </p>
    <p>
      Este almacenamiento permite recordar opciones que solicitas y no se utiliza para medir visitas
      ni mostrar publicidad (art. 22.2 LSSI-CE).
    </p>

    <h2>Analítica opcional</h2>
    <p>
      {analyticsProcessors.map((p) => p.name).join(' y ')} miden visitas y rendimiento en el despliegue
      de Vercel. Solo se activan con tu consentimiento y sus bibliotecas no documentan cookies propias
      para esta medición (art. 6.1.a RGPD y art. 22.2 LSSI-CE).
    </p>

    <h2>Cómo elegir, cambiar o retirar</h2>
    <p>
      La primera visita muestra el aviso. «Aceptar todas» activa la analítica. «Rechazar opcionales»
      deja solo lo técnico. «Configurar» (este botón) abre interruptores uno a uno.
    </p>
    <p>
      Puedes abrir «Preferencias de cookies» desde el pie de cualquier página y pulsar «Rechazar
      opcionales». La página se recarga para detener la medición. La retirada no afecta a lo tratado
      antes de ese momento.
    </p>
    <p>
      También puedes borrar cookies desde Chrome, Firefox, Safari o Edge. Si bloqueas las técnicas,
      el aviso reaparecerá y algunas funciones pueden fallar.
    </p>

    <h2>Autoridad de control</h2>
    <p>
      Agencia Española de Protección de Datos:{' '}
      <a href="https://www.aepd.es" rel="noopener noreferrer" target="_blank">www.aepd.es</a>.
    </p>
    <p>
      Dudas sobre esta política:{' '}
      <a href={`mailto:${COOKIES_CONTACT_EMAIL}`}>{COOKIES_CONTACT_EMAIL}</a>.
    </p>

    <p>
      Última actualización: <time datetime={updatedAt}>{updatedAtLabel}</time>.
    </p>
  </div>
</Layout>
