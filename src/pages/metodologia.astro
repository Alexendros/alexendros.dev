---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Commitments from '../components/Commitments.astro';
import PageHead from '../components/PageHead.astro';
import { processPage } from '../content/process';
import { seoForPath } from '../content/seo';
import { breadcrumbFromHome } from '../lib/breadcrumb';
import styles from './metodologia.module.css';

const { hero, steps, close } = processPage;
const seo = seoForPath('/metodologia/');
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/metodologia.png"
  ogImageAlt="Un método claro. Desde la propuesta hasta la entrega"
  jsonLd={breadcrumbFromHome({ name: 'Metodología', path: '/metodologia/' })}
>
  <div class:list={['page-shell', styles.page]}>
    <div class={styles.lead}>
      <PageHead titleId="metodologia-hero-title" wide>
        {hero.h1Lead}
        <span class="title-accent">{hero.h1Accent}</span>
      </PageHead>

      <div class="grid w-full items-start gap-10 lg:grid-cols-2 lg:gap-12">
        <section id="proceso" aria-labelledby="proceso-heading">
          {
            /*
            La superficie envuelve título + lista: ol solo admite li (HTML válido).
            Visualmente el H2 queda dentro de la misma tarjeta que los pasos.
          */
          }
          <div class="surface-panel stack-block">
            <h2 id="proceso-heading" class="heading-2 mb-6">Cómo se trabaja</h2>
            <ol class="steps steps-column list-none">
              {
                steps.map((step, i) => (
                  <li class:list={['step', styles['step-align']]} data-content={String(i + 1)}>
                    <div class="min-w-0 text-left">
                      <h3 class:list={['text-step-1 font-bold', styles['step-title']]}>
                        {step.title}
                      </h3>
                      <p class="mt-2 text-step--1 text-muted">{step.description}</p>
                      <p class="mt-3 text-step--1">
                        <strong>Se recibe:</strong> {step.receive}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section aria-labelledby="compromisos-heading">
          <Commitments
            heading="Compromisos iniciales"
            headingId="compromisos-heading"
            showHeading
            layout="column"
          />
        </section>
      </div>
    </div>

    <section class:list={['max-w-2xl', styles.close]} aria-labelledby="metodologia-close-heading">
      <h2 id="metodologia-close-heading" class="heading-2">
        {close.heading}
      </h2>
      <p class="mt-3 text-muted">{close.body}</p>
      <div class="mt-6">
        <Button href={close.href}>Enviar solicitud</Button>
      </div>
    </section>
  </div>
</Layout>
