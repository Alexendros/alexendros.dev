---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { processPage } from '../content/process';

const {
  seo,
  hero,
  processSection,
  steps,
  qualitySection,
  criteria,
  evidence,
  termsSection,
  terms,
  faqs,
  close
} = processPage;
---

<Layout title={seo.title} description={seo.description}>
  <div class="delivery-page">
    <section class="delivery-section delivery-section-hero" aria-labelledby="delivery-hero-title">
      <div class="delivery-split delivery-split-hero">
        <div>
          <h1 id="delivery-hero-title" class="delivery-title">
            {hero.h1Lead}{' '}
            <span class="delivery-title-accent">{hero.h1Accent}</span>
          </h1>
          <p class="delivery-lead">{hero.lead}</p>
          <div class="delivery-actions">
            <Button href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
            <a class="delivery-link" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
          </div>
        </div>
        <aside class="delivery-panel" aria-labelledby="delivery-summary-title">
          <h2 id="delivery-summary-title" class="delivery-subheading">{hero.summaryTitle}</h2>
          <ul class="delivery-stack">
            {hero.agreementPoints.map((point) => <li class="delivery-stack-item">{point}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section id="proceso" class="delivery-section" aria-labelledby="delivery-process-heading">
      <header class="delivery-header">
        <h2 id="delivery-process-heading" class="delivery-heading">{processSection.heading}</h2>
        <p class="delivery-muted">{processSection.intro}</p>
      </header>
      <ol class="delivery-grid delivery-grid-steps">
        {
          steps.map((step, index) => (
            <li class="delivery-item delivery-item-ruled">
              <span class="delivery-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="delivery-subheading">{step.title}</h3>
              <p class="delivery-muted">{step.description}</p>
              <p class="delivery-note">
                <strong>Resultado:</strong> {step.output}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="delivery-section" aria-labelledby="delivery-quality-heading">
      <header class="delivery-header">
        <h2 id="delivery-quality-heading" class="delivery-heading">{qualitySection.heading}</h2>
        <p class="delivery-muted">{qualitySection.intro}</p>
      </header>
      <div class="delivery-grid delivery-grid-cards">
        {
          criteria.map((criterion) => (
            <article class="delivery-panel">
              <h3 class="delivery-subheading">{criterion.title}</h3>
              <p class="delivery-muted">{criterion.benefit}</p>
              <p class="delivery-note">
                <strong>Comprobación:</strong> {criterion.verification}
              </p>
            </article>
          ))
        }
      </div>
      <aside class="delivery-panel delivery-panel-soft">
        <h3 class="delivery-subheading">{evidence.heading}</h3>
        <p class="delivery-muted">{evidence.body}</p>
        <p>
          <a class="delivery-link" href={evidence.linkHref}>{evidence.linkLabel}</a>
        </p>
      </aside>
    </section>

    <section class="delivery-section" aria-labelledby="delivery-terms-heading">
      <div class="delivery-split delivery-split-terms">
        <header class="delivery-header">
          <h2 id="delivery-terms-heading" class="delivery-heading">{termsSection.heading}</h2>
          <p class="delivery-muted">{termsSection.intro}</p>
        </header>
        <ul class="delivery-stack">
          {
            terms.map((term) => (
              <li class="delivery-stack-item">
                <h3 class="delivery-subheading">{term.title}</h3>
                <p class="delivery-muted">{term.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="delivery-section" aria-labelledby="delivery-faq-heading">
      <header class="delivery-header">
        <h2 id="delivery-faq-heading" class="delivery-heading">Las dudas importantes, resueltas</h2>
      </header>
      <div class="delivery-stack delivery-stack-narrow">
        {
          faqs.map((faq) => (
            <details class="delivery-stack-item">
              <summary class="delivery-faq-summary">{faq.question}</summary>
              <p class="delivery-muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section
      class="delivery-section delivery-section-close"
      aria-labelledby="delivery-close-heading"
    >
      <div class="delivery-panel delivery-panel-soft delivery-split delivery-split-close">
        <header class="delivery-header">
          <h2 id="delivery-close-heading" class="delivery-heading">{close.heading}</h2>
          <p class="delivery-muted">{close.body}</p>
        </header>
        <Button href={close.cta.href}>{close.cta.label}</Button>
      </div>
    </section>
  </div>
</Layout>
