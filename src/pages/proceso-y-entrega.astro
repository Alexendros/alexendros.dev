---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import { processPage } from '../content/process';

const {
  seo,
  hero,
  processSection,
  steps,
  alwaysIncludes,
  pathsSection,
  paths,
  featuredCase,
  faqsSection,
  faqs,
  limits,
  close
} = processPage;
---

<Layout title={seo.title} description={seo.description} ogImage="/og/proceso-y-entrega.png">
  <Container class="py-16 md:py-24">
    <header>
      <h1 id="delivery-hero-title" class="text-4xl font-bold max-w-3xl">
        {hero.h1Lead}{' '}
        <span class="text-primary">{hero.h1Accent}</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
      <p class="text-muted mt-3 max-w-2xl">{hero.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <Button href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
        <Link href={hero.secondaryCta.href} variant="inline">{hero.secondaryCta.label}</Link>
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-3 list-none p-0 m-0" aria-label="Tres garantías">
        {
          hero.guarantees.map((item) => (
            <li class="border border-border rounded-lg p-4 bg-card text-sm">{item}</li>
          ))
        }
      </ul>
    </header>

    <section
      id="proceso"
      class="mt-16 scroll-mt-[calc(var(--header-h)+var(--space-6))]"
      aria-labelledby="delivery-process-heading"
    >
      <h2 id="delivery-process-heading" class="text-2xl font-bold max-w-2xl">
        {processSection.heading}
      </h2>
      <p class="text-sm text-muted mt-2 max-w-2xl">{processSection.intro}</p>
      <Grid
        as="ol"
        gap="6"
        role="list"
        class="steps mt-8 md:grid-cols-2 lg:grid-cols-4 list-none p-0"
      >
        {
          steps.map((step) => (
            <li class="min-w-0 border-t-2 border-primary pt-5">
              <span class="steps-num block font-mono text-sm text-primary" aria-hidden="true" />
              <h3 class="font-bold text-lg mt-2">{step.title}</h3>
              <p class="mt-1 text-xs font-mono text-primary">{step.duration}</p>
              <p class="mt-3 text-sm text-muted">{step.description}</p>
              <p class="mt-4 text-sm">
                <strong>Tú recibes:</strong> {step.receive}
              </p>
              {step.payment ? <p class="mt-2 text-sm text-muted">{step.payment}</p> : null}
            </li>
          ))
        }
      </Grid>
      <div class="mt-8 border border-border rounded-lg p-5 bg-[var(--bg-subtle)]">
        <h3 class="font-bold text-sm">{alwaysIncludes.heading}</h3>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 list-none p-0 m-0 text-sm text-muted">
          {alwaysIncludes.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="delivery-paths-heading">
      <h2 id="delivery-paths-heading" class="text-2xl font-bold max-w-2xl">
        {pathsSection.heading}
      </h2>
      <p class="text-sm text-muted mt-2 max-w-2xl">{pathsSection.intro}</p>
      <Grid gap="6" class="mt-8 md:grid-cols-3">
        {
          paths.map((path) => (
            <article class="border border-border rounded-lg p-5 bg-card h-full flex flex-col">
              <h3 class="font-bold text-lg">{path.title}</h3>
              <p class="mt-3 text-sm text-muted grow">{path.body}</p>
              <p class="mt-4 text-sm font-medium">{path.priceLabel}</p>
              <p class="mt-3">
                <Link href={path.href} variant="arrow" class="text-sm">
                  {path.linkLabel}
                </Link>
              </p>
            </article>
          ))
        }
      </Grid>
    </section>

    <section class="mt-16" aria-labelledby="featured-case">
      <h2 id="featured-case" class="text-2xl font-bold">Un caso</h2>
      <article class="mt-8 border border-border rounded-lg p-5 bg-card max-w-3xl">
        <h3 class="font-bold text-lg">{featuredCase.title}</h3>
        <p class="mt-3 text-sm text-muted">{featuredCase.before}</p>
        <p class="mt-2 text-sm text-muted">{featuredCase.did}</p>
        <p class="mt-2 text-sm text-muted">{featuredCase.after}</p>
        <p class="mt-3">
          <Link href={featuredCase.href} variant="arrow" class="text-sm">
            {featuredCase.linkLabel}
          </Link>
        </p>
      </article>
    </section>

    <section class="mt-16" aria-labelledby="delivery-faq-heading">
      <h2 id="delivery-faq-heading" class="text-2xl font-bold">{faqsSection.heading}</h2>
      <div class="mt-8 max-w-3xl space-y-4">
        {
          faqs.map((faq) => (
            <details class="border border-border rounded-lg p-5 bg-card">
              <summary class="font-bold text-sm cursor-pointer focus-ring rounded">
                {faq.question}
              </summary>
              <p class="mt-3 text-sm text-muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-6 max-w-3xl text-xs text-muted">
        <strong class="text-fg">{limits.heading}.</strong>
        {limits.body}
      </p>
    </section>

    <section class="mt-16" aria-labelledby="delivery-close-heading">
      <div
        class="border border-border rounded-lg p-5 bg-[var(--bg-subtle)] flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 id="delivery-close-heading" class="text-2xl font-bold">{close.heading}</h2>
          <p class="text-sm text-muted mt-2 max-w-2xl">{close.body}</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <Button href={close.primaryCta.href}>{close.primaryCta.label}</Button>
          <Link
            href={close.secondaryCta.href}
            variant="inline"
            target="_blank"
            rel="noopener noreferrer"
          >
            {close.secondaryCta.label}
          </Link>
        </div>
      </div>
    </section>
  </Container>
</Layout>
