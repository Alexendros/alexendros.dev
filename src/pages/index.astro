---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import Link from '../components/Link.astro';
import Button from '../components/Button.astro';
import { formatEuro, provisionalPrices } from '../content/pricing';
import { projects } from '../content/projects';

const paths = [
  {
    title: 'Una web o landing',
    body: 'Para que te encuentren y te escriban.',
    price: `Desde ${formatEuro(provisionalPrices.portalInicio)} + IVA`,
    href: '/servicios?origen=home#portal-heading',
    linkLabel: 'Ver webs y landings'
  },
  {
    title: 'Colaboración en software',
    body: 'Me integro en proyectos grandes con el equipo, por fases.',
    price: 'Precio por fase en la propuesta',
    href: '/servicios/software-a-medida?origen=home',
    linkLabel: 'Ver colaboración en software'
  },
  {
    title: 'Revisar tu web',
    body: 'Informe SEO con métricas y plan de ajustes.',
    price: `Desde ${formatEuro(provisionalPrices.informeComercial)} + IVA`,
    href: '/servicios/informe-comercial?origen=home',
    linkLabel: 'Ver posicionamiento en buscadores'
  }
];

const howSteps = [
  'Hablamos sin coste',
  'Lo dejamos por escrito',
  'Lo construyo con avances visibles',
  'Lo probamos y lo publico'
];

const featured = projects.find((p) => p.slug === 'zedazo')!;
---

<Layout ogImage="/og/home.png" ogImageAlt="Alexendros.dev — webs y software a medida">
  <Hero />
  <Container class="pb-16 md:pb-24">
    <section aria-labelledby="home-paths-heading" class="mt-4">
      <h2 id="home-paths-heading" class="text-2xl font-bold">¿Qué necesitas?</h2>
      <Grid gap="6" class="mt-8 md:grid-cols-3">
        {
          paths.map((path) => (
            <article class="border border-border rounded-lg p-5 bg-card h-full flex flex-col">
              <h3 class="font-bold text-lg">{path.title}</h3>
              <p class="mt-3 text-sm text-muted grow">{path.body}</p>
              <p class="mt-4 text-sm font-medium">{path.price}</p>
              <p class="mt-3">
                <Link href={path.href} variant="arrow" class="text-sm">
                  {path.linkLabel}
                </Link>
              </p>
            </article>
          ))
        }
      </Grid>
    </section>

    <section aria-labelledby="home-process-heading" class="mt-16">
      <h2 id="home-process-heading" class="text-2xl font-bold">Cómo trabajo</h2>
      <ol class="steps mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 list-none p-0 m-0" role="list">
        {
          howSteps.map((step) => (
            <li class="border-t-2 border-primary pt-4">
              <span class="steps-num block font-mono text-sm text-primary" aria-hidden="true" />
              <p class="mt-2 text-sm font-medium">{step}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6">
        <Link href="/proceso-y-entrega?origen=home" variant="arrow"> Ver el proceso completo </Link>
      </p>
    </section>

    <section aria-labelledby="home-case-heading" class="mt-16">
      <h2 id="home-case-heading" class="text-2xl font-bold">Un caso</h2>
      <article class="mt-6 border border-border rounded-lg p-5 bg-card max-w-3xl">
        <h3 class="font-bold text-lg">{featured.title}</h3>
        <p class="mt-3 text-sm text-muted">
          <strong class="text-fg">Punto de partida.</strong>
          {featured.context}
        </p>
        <p class="mt-2 text-sm text-muted">
          <strong class="text-fg">Qué hice.</strong>
          {featured.solution}
        </p>
        <p class="mt-2 text-sm text-muted">
          <strong class="text-fg">Qué cambió.</strong>
          {(featured.results && featured.results[0]) || featured.highlights[0]}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <Button href={`/proyectos/${featured.slug}?origen=home`}>Ver el caso</Button>
          <Link href="/proyectos?origen=home" variant="inline">Todos los proyectos</Link>
        </div>
      </article>
    </section>
  </Container>
</Layout>
