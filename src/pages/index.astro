---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { services } from '../content/services';
import { getFeaturedProjects } from '../content/projects';

const featured = getFeaturedProjects().slice(0, 3);
---

<Layout>
  <Hero />

  <Container class="pt-4 md:pt-6">
    <p class="font-mono text-xs tracking-[0.1em] text-muted">
      Servicios · Referencias · Metodología · Valores
    </p>
  </Container>

  <Section reveal>
    <Container>
      <SectionHeader
        index="01"
        title="Servicios"
        description="Informe comercial, sesión profesional y auditoría de normativa y ciberseguridad. Portal de inicio configurable por módulos."
        linkHref="/servicios"
        linkText="Ver catálogo"
      />
      <Grid gap="6" class="mt-6 sm:grid-cols-2 lg:grid-cols-3" data-services-grid>
        {
          services.map((s, i) => (
            <div data-reveal style={`--i:${i}`}>
              <ServiceCard service={s} headingLevel="h3" />
            </div>
          ))
        }
      </Grid>
    </Container>
  </Section>

  <Section reveal>
    <Container>
      <SectionHeader
        index="02"
        title="Referencias"
        description="En cada proyecto verás el problema, lo que se hizo y qué cambió."
        linkHref="/proyectos"
        linkText="Ver todas"
      />
      <Grid gap="6" class="mt-6 md:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((p, i) => (
            <div data-reveal style={`--i:${i}`}>
              <ProjectCard project={p} headingLevel="h3" />
            </div>
          ))
        }
      </Grid>
    </Container>
  </Section>

  <Section reveal>
    <Container>
      <SectionHeader
        index="03"
        title="Metodología"
        description="Cinco ejes bloquean la entrega: seguridad, accesibilidad, visibilidad, mantenibilidad e identidad."
        linkHref="/metodologia"
        linkText="Ver metodología"
      />
      <p class="mt-4 text-sm text-muted max-w-2xl">
        Sección en desarrollo. Umbrales medibles y ciclo auditoría → propuesta → integración.
      </p>
    </Container>
  </Section>

  <Section reveal>
    <Container class="text-center">
      <SectionHeader
        index="04"
        align="center"
        title="Valores"
        description="Presupuesto desglosado, pago fraccionado sin recargo, mantenimiento del dominio y resultados comprobables."
        linkHref="/valores"
        linkText="Ver valores"
      />
      <div class="mt-6">
        <Button href="/contacto">Más información</Button>
      </div>
    </Container>
  </Section>
</Layout>
