---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import Link from '../components/Link.astro';

const paths = [
  {
    title: 'Página web para profesionales y emprendedores',
    body: 'Presencia clara para captar consultas, con alcance y condiciones acordados por escrito.',
    href: '/servicios?origen=home#portal-heading',
    linkLabel: 'Ver en catálogo'
  },
  {
    title: 'Integración de catálogo y pagos',
    body: 'Catálogo, pedidos y cobro con módulos configurables según el alcance.',
    href: '/servicios?origen=home#portal-heading',
    linkLabel: 'Ver en catálogo'
  },
  {
    title: 'Aplicaciones útiles para ordenadores con Linux',
    body: 'Herramientas locales para trabajo diario, con entrega y documentación claras.',
    href: '/contacto?motivo=propuestaComercial&origen=home-linux',
    linkLabel: 'Solicitar propuesta'
  },
  {
    title: 'Integración de Inteligencia Artificial en procesos empresariales y oficios',
    body: 'Automatización y asistencia en tareas concretas, con límites y criterios definidos.',
    href: '/contacto?motivo=propuestaComercial&origen=home-ia',
    linkLabel: 'Solicitar propuesta'
  }
];
---

<Layout ogImage="/og/home.png" ogImageAlt="Alexendros.dev — servicios informáticos y tecnologías">
  <Hero />
  <Container class="pb-16 md:pb-24">
    <section aria-labelledby="home-paths-heading" class="mt-4">
      <h2 id="home-paths-heading" class="text-2xl font-bold">Encargos habituales</h2>
      <Grid gap="6" class="mt-8 md:grid-cols-2">
        {
          paths.map((path) => (
            <article class="border border-border rounded-lg p-5 bg-card h-full flex flex-col">
              <h3 class="font-bold text-lg">{path.title}</h3>
              <p class="mt-3 text-sm text-muted grow">{path.body}</p>
              <p class="mt-3">
                <Link href={path.href} variant="arrow" class="text-sm">
                  {path.linkLabel}
                </Link>
              </p>
            </article>
          ))
        }
      </Grid>
    </section>
  </Container>
</Layout>
