---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import Link from '../components/Link.astro';

const paths = [
  {
    title: 'Sitio web profesional',
    body: 'Presencia clara para recibir consultas, con alcance y condiciones acordados por escrito.',
    href: '/servicios?origen=home#portal-heading',
    linkLabel: 'Ver módulos del sitio web'
  },
  {
    title: 'Integración de catálogo y pagos',
    body: 'Catálogo y cobro conectados al sitio, con el alcance definido en cada caso.',
    href: '/servicios?origen=home#portal-heading',
    linkLabel: 'Ver módulo de catálogo y pagos'
  },
  {
    title: 'Auditoría técnica SEO',
    body: 'Revisión de indexación, estructura y rendimiento, con incidencias priorizadas.',
    href: '/servicios/informe-comercial?origen=home',
    linkLabel: 'Ver auditoría SEO'
  },
  {
    title: 'Colaboración en proyectos de software',
    body: 'Trabajo por fases con equipos que ya tienen un producto en marcha.',
    href: '/servicios/software-a-medida?origen=home',
    linkLabel: 'Ver colaboración'
  }
];
---

<Layout ogImage="/og/home.png" ogImageAlt="Alexendros.dev — servicios informáticos y tecnologías">
  <Hero />
  <Container class="pb-16 md:pb-24">
    <section aria-labelledby="home-paths-heading" class="mt-4">
      <h2 id="home-paths-heading" class="text-2xl font-bold">Encargos habituales</h2>
      <Grid gap="6" class="mt-8 md:grid-cols-2">
        {
          paths.map((path) => (
            <article class="border border-border rounded-lg p-5 bg-card h-full flex flex-col">
              <h3 class="font-bold text-lg">{path.title}</h3>
              <p class="mt-3 text-sm text-muted grow">{path.body}</p>
              <p class="mt-3">
                <Link href={path.href} variant="arrow" class="text-sm">
                  {path.linkLabel}
                </Link>
              </p>
            </article>
          ))
        }
      </Grid>
    </section>
  </Container>
</Layout>
