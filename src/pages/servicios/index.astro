---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Button from '../../components/Button.astro';
import Paquetes from '../../components/Paquetes.astro';
import { paquetesPublicados } from '../../content/paquetes';
import { serviceProducts } from '../../content/services';

const collaboration = serviceProducts[0];
---

<Layout
  title="Servicios profesionales — Alexendros"
  description="Colaboración técnica y sitio profesional por módulos."
  ogImage="/og/servicios.png"
  ogImageAlt="Servicios profesionales de Alexendros.dev"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <header>
      <h1 class="text-step-3 break-words font-bold max-w-5xl text-balance">
        Catálogo de servicios profesionales en{' '}
        <span class="text-primary">respuesta a necesidades reales</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
      <p class="text-muted mt-3 max-w-2xl">
        Colaboración por fases: se define el alcance de cada encargo y se entrega un trabajo
        acotado, con sus límites por escrito.
      </p>
    </header>
    {paquetesPublicados && <Paquetes headingLevel="h2" />}
    <p class="mt-4 max-w-2xl text-sm text-muted" data-services-proposal-note>
      El alcance, el calendario y las condiciones económicas se detallan en cada propuesta.
    </p>
    <div class="mt-6" data-services-primary-action>
      <Button href="/contacto/?motivo=propuestaComercial&origen=servicios">
        Solicitar propuesta
      </Button>
    </div>
    {
      collaboration && (
        <div class="mt-8 max-w-md">
          <ServiceCard product={collaboration} />
        </div>
      )
    }
  </div>
</Layout>
