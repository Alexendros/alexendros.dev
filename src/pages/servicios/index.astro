---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Container from '../../components/Container.astro';
import Grid from '../../components/Grid.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import PricingConfigurator from '../../components/PricingConfigurator';
import { serviceProducts } from '../../content/services';
---

<Layout
  title="Servicios profesionales — Alexendros"
  description="Posicionamiento en buscadores, cumplimiento normativo, ciberseguridad, colaboración técnica y portal web configurable por módulos."
  ogImage="/og/servicios.png"
  ogImageAlt="Servicios profesionales de Alexendros.dev"
>
  <Container class="py-16 md:py-24">
    <PageHead
      title="Servicios profesionales"
      description="Catálogo de servicios: presencia en internet, revisión de páginas existentes y colaboración técnica por fases."
    />
    <p class="mt-4 max-w-2xl text-sm text-muted" data-services-price-note>
      Precio, pago y plazo orientativos; el importe final va en la propuesta. Los importes
      publicados se muestran + IVA.
    </p>
    <Grid gap="6" class="mt-8 md:grid-cols-2 lg:grid-cols-4" data-services-grid>
      {
        serviceProducts.map((product, i) => (
          <div data-reveal style={`--i:${i}`}>
            <ServiceCard product={product} />
          </div>
        ))
      }
    </Grid>

    <section class="mt-16" aria-labelledby="portal-heading">
      <PricingConfigurator client:load />
      <noscript>
        <p class="mt-4 rounded-lg border border-border bg-card p-4 text-sm">
          Sin JavaScript el configurador no actualiza el total. Puedes{' '}
          <a
            href="/contacto?motivo=propuestaComercial"
            class="underline decoration-dotted underline-offset-2 text-primary"
          >
            pedir una propuesta
          </a>{' '}
          indicando los módulos de interés.
        </p>
      </noscript>
    </section>
  </Container>
</Layout>
