---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Container from '../../components/Container.astro';
import Grid from '../../components/Grid.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import PricingConfigurator from '../../components/PricingConfigurator';
import { serviceProducts } from '../../content/services';
---

<Layout
  title="Servicios — Alexendros"
  description="Informe 360º, sesión profesional, inspección de cumplimiento normativo y vulnerabilidades, y portal web configurable por módulos."
>
  <Container class="py-16 md:py-24">
    <PageHead
      title="Servicios"
      description="Catálogo con precio, pago, plazo, entrega y garantía. Los importes son provisionales."
    />
    <Grid gap="6" class="mt-8 md:grid-cols-3" data-services-grid>
      {
        serviceProducts.map((product, i) => (
          <div data-reveal style={`--i:${i}`}>
            <ServiceCard product={product} />
          </div>
        ))
      }
    </Grid>

    <section class="mt-16" aria-labelledby="portal-heading">
      <PricingConfigurator client:load />
    </section>
  </Container>
</Layout>
