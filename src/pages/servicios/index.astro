---
import Layout from '../../layouts/Layout.astro';
import Catalogo from '../../components/Catalogo.astro';
import Paquetes from '../../components/Paquetes.astro';
import PageHead from '../../components/PageHead.astro';
import { catalogoPromocional } from '../../content/catalogo';
import { paquetesPublicados } from '../../content/paquetes';
import { seoForPath } from '../../content/seo';
import { breadcrumbFromHome } from '../../lib/breadcrumb';

const seo = seoForPath('/servicios/');
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/servicios.png"
  ogImageAlt="Servicios profesionales de Alexendros.dev"
  jsonLd={breadcrumbFromHome({ name: 'Servicios', path: '/servicios/' })}
>
  <div class="page-shell">
    <PageHead wide>
      Soluciones tecnológicas de calidad{' '}
      <span class="title-accent">en respuesta a necesidades empresariales.</span>
      <p slot="description" class="mx-auto mt-3 max-w-5xl text-muted" data-services-proposal-note>
        Colaboración por fases: se define el alcance de cada encargo y se entrega un trabajo
        acotado, con sus límites por escrito. El alcance, el calendario y las condiciones económicas
        se detallan en cada propuesta.
      </p>
    </PageHead>
    <Catalogo items={catalogoPromocional} headingLevel="h2" />
    {paquetesPublicados && <Paquetes headingLevel="h2" />}
  </div>
</Layout>
