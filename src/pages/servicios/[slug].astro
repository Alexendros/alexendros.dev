---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import Link from '../../components/Link.astro';
import { formatEuro } from '../../content/pricing';
import { services } from '../../content/services';
export async function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const audienceItems = service.audience
  .split('·')
  .map((s) => s.trim())
  .filter(Boolean);
const pageUrl = new URL(`/servicios/${service.slug}`, 'https://alexendros.dev').href;
const isExternalCta = service.cta.startsWith('http');
const jsonLd = [
  {
    '@type': 'Service',
    name: service.title,
    description: service.short,
    url: pageUrl,
    serviceType: service.title,
    provider: {
      '@type': 'Organization',
      name: 'Alexendros',
      url: 'https://alexendros.dev'
    },
    areaServed: { '@type': 'City', name: 'Valencia' }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://alexendros.dev/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Servicios',
        item: 'https://alexendros.dev/servicios'
      },
      { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl }
    ]
  }
];
---

<Layout
  title={`${service.title} — Alexendros`}
  description={service.short}
  ogImage={`/og/servicios/${service.slug}.png`}
  jsonLd={jsonLd}
>
  <Container size="narrow" class="py-16 md:py-24">
    <div class="text-xs text-muted">
      <Link href="/servicios" variant="nav">Servicios</Link> / {service.title}
    </div>
    <h1 class="mt-2 text-4xl font-bold max-w-3xl">{service.title}</h1>
    <p class="mt-3 text-muted max-w-2xl">{service.short}</p>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2 text-sm">
      <div class="border border-border rounded-lg p-4 bg-card">
        <dt class="text-muted">Precio (provisional)</dt>
        <dd class="font-bold mt-1">{formatEuro(service.priceEuros)}</dd>
      </div>
      <div class="border border-border rounded-lg p-4 bg-card">
        <dt class="text-muted">Pago</dt>
        <dd class="font-medium mt-1">{service.payment}</dd>
      </div>
      <div class="border border-border rounded-lg p-4 bg-card">
        <dt class="text-muted">Plazo</dt>
        <dd class="font-medium mt-1">{service.timeline}</dd>
      </div>
      <div class="border border-border rounded-lg p-4 bg-card">
        <dt class="text-muted">Entrega</dt>
        <dd class="font-medium mt-1">{service.delivery}</dd>
      </div>
      <div class="border border-border rounded-lg p-4 bg-card sm:col-span-2">
        <dt class="text-muted">Garantía</dt>
        <dd class="font-medium mt-1">{service.guarantee}</dd>
      </div>
    </dl>

    <div class="mt-10 space-y-8">
      <div>
        <h2 class="text-2xl font-bold">Para quién es</h2>
        {
          audienceItems.length > 1 ? (
            <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
              {audienceItems.slice(0, 4).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-muted max-w-2xl">{service.audience}</p>
          )
        }
      </div>

      <div>
        <h2 class="text-2xl font-bold">Qué incluye</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.scope.slice(0, 5).map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold">Qué recibes</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.deliverables.slice(0, 4).map((d) => <li>{d}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold">Qué no incluye</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.exclusions.slice(0, 3).map((e) => <li>{e}</li>)}
        </ul>
      </div>

      {
        isExternalCta ? (
          <Button href={service.cta} target="_blank" rel="noopener noreferrer">
            Reservar sesión
          </Button>
        ) : (
          <Button href={service.cta}>Contactar</Button>
        )
      }

      <details class="border border-border rounded-lg p-5 bg-card">
        <summary class="font-bold cursor-pointer focus-ring rounded">Detalles técnicos</summary>
        <div class="mt-3 space-y-2 text-sm text-muted">
          {service.technologies.map((t) => <p>{t}</p>)}
        </div>
      </details>
    </div>
  </Container>
</Layout>
