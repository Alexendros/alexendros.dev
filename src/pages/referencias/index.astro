---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DetailIsland from '../../components/DetailIsland.astro';
import PageHead from '../../components/PageHead.astro';
import {
  availabilityCtaLabels,
  productTypeLabels,
  projectFilters,
  projects
} from '../../content/projects';

const detailItems = projects.map((p) => ({
  slug: p.slug,
  path: `/referencias/${p.slug}/`,
  title: p.title,
  short: p.short,
  description: p.summary,
  meta: productTypeLabels[p.productType],
  ctaLabel: availabilityCtaLabels[p.availability],
  ctaHref: `/contacto/?motivo=informacionCliente&proyecto=${p.slug}&origen=referencias`
}));
---

<Layout
  title="Proyectos realizados — Alexendros"
  description="Proyectos realizados con el alcance acordado en cada caso."
  ogImage="/og/proyectos.png"
  ogImageAlt="Proyectos realizados"
>
  <div class="page-shell">
    <PageHead title="Proyectos realizados." />

    <div
      class="stack-gap flex flex-wrap gap-2"
      role="group"
      aria-label="Filtrar referencias por tipo"
      data-ref-filters
    >
      {
        projectFilters.map((filter, index) => (
          <button
            type="button"
            class:list={['btn', index === 0 && 'btn-active']}
            data-filter={filter.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {filter.label}
          </button>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" data-ref-live></p>

    <div class="stack-gap grid gap-6 md:grid-cols-2" data-ref-grid>
      {
        projects.map((project, index) => (
          <div class="h-full" data-kind={project.workKind === 'encargo' ? 'encargo' : 'propio'}>
            <ProjectCard project={project} priority={index === 0} />
          </div>
        ))
      }
    </div>
    <DetailIsland basePath="/referencias" items={detailItems} />
  </div>
</Layout>

<script>
  import { initReferenceFilter } from '../../scripts/referenceFilter';
  initReferenceFilter();
</script>
