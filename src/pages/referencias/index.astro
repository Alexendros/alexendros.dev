---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHead from '../../components/PageHead.astro';
import { projectFilters, projects } from '../../content/projects';
import { seoForPath } from '../../content/seo';
import { breadcrumbFromHome } from '../../lib/breadcrumb';

const seo = seoForPath('/referencias/');
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/proyectos.png"
  ogImageAlt="Trabajo publicado, para quien quiera comprobarlo"
  jsonLd={breadcrumbFromHome({ name: 'Referencias', path: '/referencias/' })}
>
  <div class="page-shell">
    <PageHead wide>
      Trabajo publicado,{' '}
      <span class="title-accent">para quien quiera comprobarlo.</span>
    </PageHead>

    <div
      class="stack-gap flex flex-wrap gap-2"
      role="group"
      aria-label="Filtrar referencias por tipo"
      data-ref-filters
    >
      {
        projectFilters.map((filter, index) => (
          <button
            type="button"
            class:list={[
              'btn',
              'btn-outline',
              'min-h-11',
              'focus-ring',
              index === 0 && 'btn-active'
            ]}
            data-filter={filter.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {filter.label}
          </button>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" data-ref-live></p>
    <p class="stack-gap text-step--1 text-muted" hidden data-ref-empty>
      No hay referencias de este tipo.
    </p>

    <div class="stack-gap grid gap-6 md:grid-cols-2" data-ref-grid>
      {
        projects.map((project, index) => (
          <div class="h-full" data-kind={project.workKind === 'encargo' ? 'encargo' : 'propio'}>
            <ProjectCard project={project} priority={index === 0} />
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  import { initReferenceFilter } from '../../scripts/referenceFilter';
  initReferenceFilter();
</script>
