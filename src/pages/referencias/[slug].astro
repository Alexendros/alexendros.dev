---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Link from '../../components/Link.astro';
import Icon from '../../components/ui/Icon.astro';
import { Image } from 'astro:assets';
import {
  availabilityCtaLabels,
  productTypeLabels,
  projects,
  workKindLabels
} from '../../content/projects';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const statusLabel =
  project.slug === 'zedazo'
    ? 'Herramienta propia, de código abierto'
    : `${productTypeLabels[project.productType]} · ${workKindLabels[project.workKind]}`;
const resultItems =
  project.results && project.results.length > 0 ? project.results : project.highlights;
const hasLinks = Boolean(project.links.prod || project.links.github);
---

<Layout
  title={`${project.title} — Alexendros`}
  description={project.short}
  ogImage={`/og/proyectos/${project.slug}.png`}
  ogImageAlt={`Ficha de ${project.title}`}
>
  <div class="page-shell page-shell-narrow">
    <div class="text-step--1 text-muted">
      <Link href="/referencias/" variant="nav" class="inline-flex min-h-11 items-center gap-1">
        <Icon name="arrow-left" size={14} /> Todas las referencias
      </Link>
    </div>
    <h1 class="mt-3 text-step-3 break-words font-bold text-balance">{project.title}</h1>
    <p class="mt-3 text-muted text-pretty">{project.summary}</p>
    <p class="mt-3 font-mono text-step--1 text-muted text-pretty break-words">{statusLabel}</p>
    <div class="mt-4 h-px bg-border" aria-hidden="true"></div>
    <figure class="mt-6 overflow-hidden radius-surface border border-border">
      <Image
        src={project.cover}
        alt={project.coverAlt}
        widths={[800, 1200]}
        sizes="(max-width: 768px) 100vw, 800px"
        class="block h-auto w-full max-w-full"
        loading="eager"
        decoding="async"
      />
    </figure>

    {
      project.metrics && project.metrics.length > 0 && (
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {project.metrics.map((m) => (
            <div class="radius-surface border border-border bg-card p-4">
              <p class="text-step-2 font-bold text-fg">{m.value}</p>
              <p class="mt-1 text-step--1 text-muted">{m.label}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      project.testimonial && (
        <figure class="mt-6 border-l-2 border-primary pl-5">
          <blockquote class="text-step--1 italic text-fg">«{project.testimonial.quote}»</blockquote>
          <figcaption class="mt-2 text-step--1 text-muted">
            {project.testimonial.author}
            {project.testimonial.role && <span> · {project.testimonial.role}</span>}
          </figcaption>
        </figure>
      )
    }

    <div class="stack-block grid gap-10 md:grid-cols-[1.2fr_0.8fr]">
      <div class="min-w-0 space-y-8 text-step--1">
        <div>
          <h2 class="text-step-2 font-bold">Punto de partida</h2>
          <p class="mt-2 text-muted text-pretty">{project.context}</p>
        </div>
        <div>
          <h2 class="text-step-2 font-bold">Qué se hizo</h2>
          <p class="mt-2 text-muted text-pretty">{project.solution}</p>
        </div>
        <div>
          <h2 class="text-step-2 font-bold">Resultado</h2>
          <ul class="mt-2 list-disc space-y-2 pl-5 text-muted">
            {resultItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="min-w-0 space-y-6">
        <details class="project-details radius-surface border border-border bg-card p-5">
          <summary class="focus-ring cursor-pointer rounded text-step--1 font-bold"
            >Ficha técnica</summary
          >
          <dl class="mt-4 space-y-4 text-step--1 text-muted">
            <div>
              <dt class="font-bold text-fg">Alcance</dt>
              <dd class="mt-1">
                <ul class="list-disc space-y-1 pl-5">
                  {project.responsibilities.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-fg">Tecnología</dt>
              <dd class="mt-1">
                <ul class="list-disc space-y-1 pl-5">
                  {project.technologies.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
            {
              hasLinks && (
                <div>
                  <dt class="font-bold text-fg">Enlaces</dt>
                  <dd class="mt-1 flex flex-wrap gap-3">
                    {project.links.prod && (
                      <Link
                        href={project.links.prod}
                        variant="inline"
                        class="inline-flex min-h-11 items-center"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Ver {project.title} en vivo
                        <span class="sr-only"> (abre en otra pestaña)</span>
                      </Link>
                    )}
                    {project.links.github && (
                      <Link
                        href={project.links.github}
                        variant="inline"
                        class="inline-flex min-h-11 items-center"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Código de {project.title}
                        <span class="sr-only"> (abre en otra pestaña)</span>
                      </Link>
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
        </details>

        <Button
          href={`/contacto/?motivo=informacionCliente&origen=referencias&proyecto=${encodeURIComponent(project.slug)}`}
          class="w-full"
        >
          {availabilityCtaLabels[project.availability]}
        </Button>
      </div>
    </div>
  </div>
</Layout>
