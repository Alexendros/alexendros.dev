---
import Layout from '../../layouts/Layout.astro';
import ProjectFicha from '../../components/ProjectFicha.astro';
import { projects } from '../../content/projects';
import { seoForProject } from '../../content/seo';
import { breadcrumbFromHome } from '../../lib/breadcrumb';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const seo = seoForProject(project.slug);
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage={`/og/proyectos/${project.slug}.png`}
  ogImageAlt={`Ficha de ${project.title}`}
  jsonLd={breadcrumbFromHome(
    { name: 'Referencias', path: '/referencias/' },
    { name: project.title, path: `/referencias/${project.slug}/` }
  )}
>
  <ProjectFicha project={project} />
</Layout>
