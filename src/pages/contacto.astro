---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Container from '../components/Container.astro';
import Link from '../components/Link.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact } from '../content/contact';
import { normalizeProjectSlug, normalizeServiceSlug } from '../content/contactContext';
import { normalizePortalModuleIds, serializePortalModuleIds } from '../content/portalModules';
import { contactOrigins, contactReasons, type ContactInput } from '../lib/contactSchema';
import { site } from '../content/site';

const params = Astro.url.searchParams;
const motivoParam = params.get('motivo');
const initialReason: ContactInput['reason'] =
  motivoParam && (contactReasons as readonly string[]).includes(motivoParam)
    ? (motivoParam as ContactInput['reason'])
    : 'informacionCliente';
const origenParam = params.get('origen');
const initialOrigin: ContactInput['origin'] | '' =
  origenParam && (contactOrigins as readonly string[]).includes(origenParam)
    ? (origenParam as ContactInput['origin'])
    : '';
const initialServiceSlug = normalizeServiceSlug(params.get('servicio')) ?? '';
const initialProjectSlug = normalizeProjectSlug(params.get('proyecto')) ?? '';
const initialModules = serializePortalModuleIds(normalizePortalModuleIds(params.get('modulos')));
---

<Layout
  title="Contacto — Alexendros"
  description="Solicitud de propuesta o información. Respuesta por WhatsApp o correo según el canal elegido."
  ogImage="/og/contacto.png"
  ogImageAlt="Formulario de contacto de Alexendros.dev"
>
  <Container size="narrow" class="py-16 md:py-24">
    <PageHead
      title="Contacto"
      description="Propuesta comercial o información sobre un servicio. Alcance, plazo y condiciones quedan por escrito."
    />

    <div class="mt-10">
      <ContactForm
        successMessage={contact.messages.success}
        errorMessage={contact.messages.error}
        turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
        initialReason={initialReason}
        initialOrigin={initialOrigin}
        initialServiceSlug={initialServiceSlug}
        initialProjectSlug={initialProjectSlug}
        initialModules={initialModules}
      />
    </div>

    <!-- Visible hasta que la isla React marca hidratación usable (data-contact-hydrated). -->
    <p
      id="contact-nojs"
      data-contact-nojs
      class="mt-6 rounded-lg border border-border bg-card p-4 text-sm"
    >
      El formulario interactivo necesita JavaScript. Mientras tanto puedes escribir a{' '}
      <a
        href={site.social.email}
        class="underline decoration-dotted underline-offset-2 text-primary"
      >
        contratacion@alexendros.dev
      </a>
      {' '}indicando el motivo del encargo y el canal preferido de respuesta.
    </p>
    <noscript>
      <p class="mt-6 rounded-lg border border-border bg-card p-4 text-sm">
        Sin JavaScript puedes escribir a{' '}
        <a
          href={site.social.email}
          class="underline decoration-dotted underline-offset-2 text-primary"
        >
          contratacion@alexendros.dev
        </a>
        .
      </p>
    </noscript>

    <p class="mt-8 text-sm text-muted">
      Los datos se usan solo para responder a esta petición. Consulta la{' '}
      <Link href="/privacidad" variant="inline">política de privacidad</Link> antes de enviar.
    </p>
  </Container>
</Layout>
