---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Container from '../components/Container.astro';
import Link from '../components/Link.astro';
import ContactForm from '../components/ContactForm';
import { contact } from '../content/contact';
import { site } from '../content/site';
---

<Layout
  title="Formulario de contacto — Alexendros"
  description="Envía una petición breve. Te responderé por WhatsApp o correo según tu preferencia."
>
  <Container size="narrow" class="py-16 md:py-24">
    <PageHead kicker="CONTACTO" title="Formulario de contacto" />

    <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <li>
        <Link href={site.social.email} variant="nav" class="hover:text-primary">
          contratacion@alexendros.dev
        </Link>
      </li>
      <li>
        <Link
          href={site.social.github}
          variant="nav"
          class="hover:text-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </Link>
        <span aria-hidden="true"> ↗</span>
      </li>
      <li>
        <Link
          href={site.social.linkedin}
          variant="nav"
          class="hover:text-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </Link>
        <span aria-hidden="true"> ↗</span>
      </li>
    </ul>

    <div class="mt-10">
      <ContactForm
        client:load
        successMessage={contact.messages.success}
        errorMessage={contact.messages.error}
        turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
      />
    </div>

    <p class="mt-8 text-sm text-muted">
      Usaré tus datos solo para responder a esta petición. Consulta la{' '}
      <Link href="/privacidad" variant="inline">política de privacidad</Link> antes de enviar.
    </p>
  </Container>
</Layout>
