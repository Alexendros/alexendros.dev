---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Container from '../components/Container.astro';
import Link from '../components/Link.astro';
import ContactForm from '../components/ContactForm';
import { contact } from '../content/contact';
import { site } from '../content/site';
---

<Layout
  title="Formulario de contacto — Alexendros"
  description="Envía una petición breve. Te responderé por WhatsApp o correo según tu preferencia."
>
  <Container size="narrow" class="py-16 md:py-24">
    <PageHead kicker="CONTACTO" title="Formulario de contacto" />

    <div class="mt-10">
      <ContactForm
        client:load
        successMessage={contact.messages.success}
        errorMessage={contact.messages.error}
        turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
      />
    </div>

    <noscript>
      <p class="mt-6 rounded-lg border border-border bg-card p-4 text-sm">
        El formulario interactivo necesita JavaScript. Mientras tanto puedes escribir a{' '}
        <a
          href={site.social.email}
          class="underline decoration-dotted underline-offset-2 text-primary"
        >
          contratacion@alexendros.dev
        </a>
        {' '}indicando qué necesitas y cómo prefieres que te responda.
      </p>
    </noscript>

    <p class="mt-8 text-sm text-muted">
      Usaré tus datos solo para responder a esta petición. Consulta la{' '}
      <Link href="/privacidad" variant="inline">política de privacidad</Link> antes de enviar.
    </p>
  </Container>
</Layout>
