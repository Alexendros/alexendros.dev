---
import Layout from '../layouts/Layout.astro';
import { seoForPath } from '../content/seo';
import { breadcrumbFromHome } from '../lib/breadcrumb';

const seo = seoForPath('/identidad/');
---

<Layout
  title={seo.title}
  description={seo.description}
  jsonLd={breadcrumbFromHome({ name: 'Identidad', path: '/identidad/' })}
>
  <div class="page-shell page-shell-narrow legal-prose">
    <p class="font-mono">LEGAL</p>
    <h1>Identidad</h1>
    <p>
      Titular de Alexendros.dev: Alejandro Domingo Agustí, NIF 21002968N, Calle Pobla de Farnals
      51-18, 46022 Valencia, España. Correo de contacto:
      <a href="mailto:contratacion@alexendros.dev">contratacion@alexendros.dev</a>.
    </p>
    <p>
      Responsabilidad legal y cumplimiento mercantil sobre la presentación de servicios
      profesionales en este portal público. El sitio informa sobre servicios y productos digitales;
      no es un marketplace ni un SaaS de terceros.
    </p>
    <p>Última actualización: 29 de octubre de 2026.</p>
  </div>
</Layout>
