---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import PageHead from '../components/PageHead.astro';
import { profile } from '../content/profile';
---

<Layout
  title="Experiencia — Alexendros"
  description={profile.pageDescription}
  ogImage="/og/experiencia.png"
  ogImageAlt="Experiencia y trayectoria de Alexendros"
>
  <div class="page-shell">
    <PageHead kicker={profile.metaLine} title={profile.headline} description={profile.role} />
    <p class="mt-6 max-w-2xl text-muted">{profile.summary}</p>

    <section class="stack-block" aria-labelledby="why-heading">
      <h2 id="why-heading" class="text-step-2 font-bold">Ventajas del encargo</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          profile.workWithMe.map((item) => (
            <article class="radius-surface border border-border bg-card p-5">
              <h3 class="text-step-1 font-bold">{item.title}</h3>
              <p class="mt-3 text-step--1 text-muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="stack-block" aria-labelledby="trajectory-heading">
      <h2 id="trajectory-heading" class="text-step-2 font-bold">Trayectoria</h2>
      <p class="mt-3 max-w-2xl text-muted">{profile.trajectory}</p>
      <p class="mt-4">
        <Link href="/referencias/" variant="arrow">Ver referencias</Link>
      </p>
    </section>

    <section class="stack-block" aria-labelledby="trust-heading">
      <h2 id="trust-heading" class="text-step-2 font-bold">Modalidad de colaboración</h2>
      <ul class="mt-6 list-disc space-y-2 pl-5 text-step--1 text-muted max-w-2xl">
        {profile.trustBar.map((item) => <li>{item}</li>)}
      </ul>
      <div class="mt-8">
        <Button href="/contacto/?origen=experiencia&motivo=propuestaComercial"
          >Solicitar propuesta</Button
        >
      </div>
    </section>
  </div>
</Layout>
