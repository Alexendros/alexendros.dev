---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import { processPage } from '../content/process';

const { seo, hero, steps } = processPage;
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/proceso-y-entrega.png"
  ogImageAlt="Metodología clara e integral. Desde la idea hasta el producto entregado"
>
  <Container class="py-16 md:py-24 pb-28">
    <header>
      <h1 id="delivery-hero-title" class="text-step-3 break-words font-bold max-w-3xl text-balance">
        {hero.h1Lead}<span class="text-primary">{hero.h1Accent}</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
    </header>

    <section
      id="proceso"
      class="mt-16 scroll-mt-[calc(var(--header-h)+var(--space-6))]"
      aria-labelledby="delivery-hero-title"
    >
      <Grid as="ol" gap="6" role="list" class="steps md:grid-cols-2 lg:grid-cols-4 list-none p-0">
        {
          steps.map((step) => (
            <li class="min-w-0 border-t-2 border-primary pt-5">
              <span class="steps-num block font-mono text-sm text-primary" aria-hidden="true" />
              <h2 class="font-bold text-lg mt-2">{step.title}</h2>
              <p class="mt-1 text-xs font-mono text-primary">{step.duration}</p>
              <p class="mt-3 text-sm text-muted">{step.description}</p>
              <p class="mt-4 text-sm">
                <strong>Se recibe:</strong> {step.receive}
              </p>
            </li>
          ))
        }
      </Grid>
    </section>
  </Container>
</Layout>
