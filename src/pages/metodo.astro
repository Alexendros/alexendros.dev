---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Commitments from '../components/Commitments.astro';
import PageHead from '../components/PageHead.astro';
import { processPage } from '../content/process';
import styles from './metodo.module.css';

const { seo, hero, steps, close } = processPage;
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/metodo.png"
  ogImageAlt="Cómo se trabaja. Desde la idea hasta el producto entregado"
>
  <div class="page-shell">
    <div class={styles.balance}>
      <PageHead titleId="delivery-hero-title">
        {hero.h1Lead}<span class="text-primary">{hero.h1Accent}</span>
      </PageHead>

      <section id="proceso" class="stack-block" aria-labelledby="delivery-hero-title">
        <ol class="grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-4">
          {
            steps.map((step, i) => (
              <li class:list={['min-w-0 border-t-2 border-primary pt-5', styles.step]}>
                <span
                  class:list={[
                    'steps-num tnum block font-mono text-step--1',
                    styles['step-number']
                  ]}
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2 text-step-1 font-bold">{step.title}</h3>
                <p class="mt-3 text-step--1 text-muted">{step.description}</p>
                <p class="mt-4 text-step--1">
                  <strong>Se recibe:</strong> {step.receive}
                </p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <section class="stack-block">
      <Commitments heading="Compromisos antes de empezar" showHeading />
    </section>

    <section class="stack-block max-w-2xl" aria-labelledby="metodo-close-heading">
      <h2 id="metodo-close-heading" class="text-step-2 font-bold">
        {close.heading}
      </h2>
      <p class="mt-3 text-muted">{close.body}</p>
      <div class="mt-6">
        <Button href={close.href}>Enviar solicitud</Button>
      </div>
    </section>
  </div>
</Layout>
