---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import Button from '../components/Button.astro';
import { processPage } from '../content/process';

const { seo, hero, processSection, steps, close } = processPage;
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/proceso-y-entrega.png"
  ogImageAlt="Metodología clara desde el primer día"
>
  <Container class="py-16 md:py-24">
    <header>
      <h1 id="delivery-hero-title" class="text-4xl font-bold max-w-3xl">
        {hero.h1Lead}{' '}
        <span class="text-primary">{hero.h1Accent}</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
      <p class="text-muted mt-3 max-w-2xl">{hero.lead}</p>
    </header>

    <section
      id="proceso"
      class="mt-16 scroll-mt-[calc(var(--header-h)+var(--space-6))]"
      aria-labelledby="delivery-process-heading"
    >
      <h2 id="delivery-process-heading" class="text-2xl font-bold max-w-2xl">
        {processSection.heading}
      </h2>
      <Grid
        as="ol"
        gap="6"
        role="list"
        class="steps mt-8 md:grid-cols-2 lg:grid-cols-4 list-none p-0"
      >
        {
          steps.map((step) => (
            <li class="min-w-0 border-t-2 border-primary pt-5">
              <span class="steps-num block font-mono text-sm text-primary" aria-hidden="true" />
              <h3 class="font-bold text-lg mt-2">{step.title}</h3>
              <p class="mt-1 text-xs font-mono text-primary">{step.duration}</p>
              <p class="mt-3 text-sm text-muted">{step.description}</p>
              <p class="mt-4 text-sm">
                <strong>Se recibe:</strong> {step.receive}
              </p>
              {step.payment ? <p class="mt-2 text-sm text-muted">{step.payment}</p> : null}
            </li>
          ))
        }
      </Grid>
    </section>

    <section class="mt-16" aria-labelledby="delivery-close-heading">
      <div
        class="border border-border rounded-lg p-5 bg-[var(--bg-subtle)] flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 id="delivery-close-heading" class="text-2xl font-bold">{close.heading}</h2>
          <p class="text-sm text-muted mt-2 max-w-2xl">{close.body}</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <Button href={close.primaryCta.href}>{close.primaryCta.label}</Button>
        </div>
      </div>
    </section>
  </Container>
</Layout>
