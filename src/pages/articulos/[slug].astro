---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import Button from '../../components/Button.astro';
import PageHead from '../../components/PageHead.astro';
import { articles } from '../../content/articles';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
---

<Layout title={`${article.title} — Alexendros`} description={article.description}>
  <div class="page-shell page-shell-narrow">
    <p class="text-step--1 text-muted">
      <Link href="/" variant="nav">Inicio</Link> / Artículo
    </p>
    <PageHead title={article.title} description={article.description} />
    <p class="mt-2 font-mono text-step--1 text-muted">{article.published}</p>
    <div class="mt-10 space-y-5 text-step-0 text-muted max-w-2xl">
      {article.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="mt-12 flex flex-wrap items-center gap-4">
      <Button href="/contacto/?motivo=propuestaComercial&origen=home">Solicitar propuesta</Button>
      <Link href="/servicios/" variant="inline">Ver servicios</Link>
    </div>
  </div>
</Layout>
