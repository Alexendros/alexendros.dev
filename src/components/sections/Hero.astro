---
import { homeHero } from '../../content/home';
import Button from '../Button.astro';
import styles from './Hero.module.css';
---

<section id="top" class:list={['hero', 'scroll-mt-nav', styles.surface]}>
  <div class="hero-content w-full min-w-0 max-w-6xl flex-col items-start justify-start gap-6 px-4">
    <p
      class:list={['rise', 'rise-1', styles['terminal-prompt']]}
      data-terminal-prompt
      aria-hidden="true"
    >
      <span class="text-primary">{homeHero.prompt}</span>
      {' '}
      <span class="opacity-70">{homeHero.command}</span>
    </p>
    <h1 class:list={['rise', 'rise-2', 'text-balance', 'font-bold', styles.title]}>
      {homeHero.title}
    </h1>
    <p class:list={['rise', 'rise-3', 'max-w-2xl', styles.lead]}>{homeHero.lead}</p>
    <div class:list={['rise rise-4 flex flex-wrap gap-3', styles.actions]}>
      <Button href={homeHero.primaryCta.href} variant="primary" size="lg">
        {homeHero.primaryCta.label}
      </Button>
      <Button href={homeHero.secondaryCta.href} variant="secondary" size="lg">
        {homeHero.secondaryCta.label}
      </Button>
    </div>
  </div>
</section>
