---
import { homeHero } from '../../content/home';
import styles from './Hero.module.css';
---

<section id="top" class:list={['hero', 'scroll-mt-nav', styles.surface]}>
  <div class="hero-content w-full min-w-0 max-w-6xl flex-col items-start gap-6 px-4 py-14 lg:py-20">
    <p
      class:list={['rise', 'rise-1', styles['terminal-prompt']]}
      data-terminal-prompt
      aria-hidden="true"
    >
      <span class="text-primary">{homeHero.prompt}</span>
      {' '}
      <span class="opacity-70">{homeHero.command}</span>
    </p>
    <h1
      class="rise rise-2 max-w-4xl text-balance text-step-3 font-bold leading-tight tracking-tight"
    >
      {homeHero.title}
    </h1>
    <p class="rise rise-3 max-w-2xl text-step-0 text-muted">{homeHero.lead}</p>
    <div class:list={['rise rise-4 flex flex-wrap gap-3', styles.actions]}>
      <a class="btn btn-primary btn-lg" href={homeHero.primaryCta.href}>
        {homeHero.primaryCta.label}
      </a>
      <a class="btn btn-outline btn-lg" href={homeHero.secondaryCta.href}>
        {homeHero.secondaryCta.label}
      </a>
    </div>
  </div>
</section>
