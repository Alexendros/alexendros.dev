---
import { homeServiciosIntro } from '../../content/home';
import Paquetes from '../Paquetes.astro';
---

<section
  id="servicios"
  class="mx-auto max-w-6xl scroll-mt-nav px-4 py-20"
  aria-labelledby="servicios-heading"
>
  <p class="eyebrow">{homeServiciosIntro.eyebrow}</p>
  <h2 id="servicios-heading" class="max-w-2xl text-3xl font-extrabold tracking-tight">
    {homeServiciosIntro.title}
  </h2>
  <p class="mt-3 max-w-2xl opacity-70">{homeServiciosIntro.lead}</p>
  <Paquetes />
</section>
