---
import { homeServiciosIntro, homeVias } from '../../content/home';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import Paquetes from '../Paquetes.astro';
import { paquetesPublicados } from '../../content/paquetes';
import styles from './Servicios.module.css';
---

<section id="servicios" class="section-shell scroll-mt-nav" aria-labelledby="servicios-heading">
  <SectionHeader
    id="servicios-heading"
    eyebrow={homeServiciosIntro.eyebrow}
    title={homeServiciosIntro.title}
    description={homeServiciosIntro.lead}
  />
  {
    paquetesPublicados ? (
      <Paquetes />
    ) : (
      <div class="stack-block grid gap-6 md:grid-cols-3">
        {homeVias.map((via) => (
          <article class="min-w-0">
            <div>
              <span class="badge badge-accent badge-sm font-medium">{via.badge}</span>
            </div>
            <h3 class="mt-3 text-step-1 font-semibold leading-tight">{via.title}</h3>
            <p class="mt-2 text-muted">{via.short}</p>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Ámbitos">
              {via.tags.map((tag) => (
                <li>
                  <span class="badge badge-ghost badge-sm text-muted">{tag}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    )
  }
  <p class="stack-gap">
    <a class:list={['btn btn-outline', styles['more-link']]} href="/servicios/">
      Ver el catálogo de servicios
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</section>
