---
import { projects } from '../../content/projects';
import { homeReferenciasIntro } from '../../content/home';
import ProjectCard from '../ProjectCard.astro';
import Icon from '../ui/Icon.astro';

const featured = projects.filter((project) => project.featured).slice(0, 2);
---

<section
  id="referencias"
  class="mx-auto max-w-6xl scroll-mt-nav px-4 py-20"
  aria-labelledby="referencias-heading"
>
  <p class="eyebrow">{homeReferenciasIntro.eyebrow}</p>
  <h2 id="referencias-heading" class="max-w-2xl text-balance text-step-2 font-bold tracking-tight">
    {homeReferenciasIntro.title}
  </h2>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      featured.map((project, index) => (
        <ProjectCard project={project} headingLevel="h3" priority={index === 0} />
      ))
    }
  </div>

  <p class="mt-8">
    <a class="btn btn-outline" href="/referencias/">
      Ver todas las referencias
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</section>
