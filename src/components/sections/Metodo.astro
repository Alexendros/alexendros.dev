---
import { processPage } from '../../content/process';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../SectionHeader.astro';
---

<section
  id="metodo"
  class="mx-auto max-w-6xl scroll-mt-nav px-4 py-20"
  aria-labelledby="metodo-heading"
>
  <SectionHeader id="metodo-heading" eyebrow={processPage.eyebrow} title={processPage.title} />
  <ul
    class="steps steps-vertical surface-raised mt-10 w-full rounded-xl px-4 py-6 lg:steps-horizontal lg:px-6"
    id="steps"
  >
    {
      processPage.steps.map((step, i) => (
        <li class="step step-primary" data-content={String(i + 1)}>
          <div class="py-2 text-left lg:px-2">
            <h3 class="text-step-1 font-semibold">{step.title}</h3>
            <p class="text-sm text-muted">{step.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="mt-8">
    <a class="btn btn-outline" href="/metodo/">
      Ver el método completo
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</section>
