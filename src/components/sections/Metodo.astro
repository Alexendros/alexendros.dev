---
import { processPage } from '../../content/process';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import styles from './Metodo.module.css';
---

<section id="metodo" class="section-shell scroll-mt-nav" aria-labelledby="metodo-heading">
  <SectionHeader id="metodo-heading" eyebrow={processPage.eyebrow} title={processPage.title} />
  <ul
    class="steps steps-vertical surface-raised stack-block w-full radius-surface px-4 py-6 xl:steps-horizontal xl:overflow-y-visible xl:px-6"
    id="steps"
  >
    {
      processPage.steps.map((step, i) => (
        <li class="step step-primary" data-content={String(i + 1)}>
          <div class="py-2 text-left lg:px-2">
            <h3 class="text-step-1 font-semibold">{step.title}</h3>
            <p class="text-step--1 text-muted">{step.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="stack-gap">
    <a class:list={['btn btn-outline', styles['more-link']]} href="/metodo/">
      Ver el método completo
      <Icon name="arrow-right" size={16} />
    </a>
  </p>
</section>
