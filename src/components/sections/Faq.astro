---
import { homeFaq } from '../../content/home';

interface Props {
  heading?: string;
  id?: string;
}

const { heading = 'Preguntas frecuentes', id = 'faq' } = Astro.props;
---

<div id={id} class="scroll-mt-nav">
  <h2 class="mb-4 text-step-2 font-bold">{heading}</h2>
  <div class="flex w-full flex-col gap-2">
    {
      homeFaq.map((item, i) => (
        <details
          class="collapse collapse-plus border border-base-300 bg-base-100"
          name="faq"
          open={i === 0}
        >
          <summary class="collapse-title min-h-12 font-semibold">{item.q}</summary>
          <div class="collapse-content text-sm opacity-80">
            <p>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>
