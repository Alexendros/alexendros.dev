---
import { homeFaq } from '../../content/home';

interface Props {
  heading?: string;
  id?: string;
}

const { heading = 'Preguntas frecuentes', id = 'faq' } = Astro.props;
---

<section
  id={id}
  class="section-shell scroll-mt-nav border-t border-border"
  aria-labelledby="faq-heading"
>
  <div class="mx-auto max-w-3xl text-center">
    <p class="eyebrow mb-3">preguntas</p>
    <h2 id="faq-heading" class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
      {heading}
    </h2>
  </div>
  <div class="mx-auto mt-10 max-w-3xl">
    {
      homeFaq.map((item) => (
        <details class="faq-item" name="faq">
          <summary class="min-h-12 py-4 font-display font-bold">{item.q}</summary>
          <p class="pb-4 text-muted">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
