---
import { homeContactoIntro } from '../../content/home';
import styles from './ContactCta.module.css';
import Button from '../Button.astro';
import SectionHeader from '../SectionHeader.astro';
---

<section id="contacto" class="section-shell scroll-mt-nav" aria-labelledby="contacto-heading">
  <div
    class:list={[
      'surface-raised',
      'radius-panel',
      'px-6',
      'py-10',
      'sm:px-10',
      'sm:py-12',
      styles.panel
    ]}
    data-contact-panel
  >
    <SectionHeader
      id="contacto-heading"
      eyebrow={homeContactoIntro.eyebrow}
      title={homeContactoIntro.title}
      description={homeContactoIntro.lead}
    />
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Condiciones">
      {
        homeContactoIntro.badges.map((badge) => (
          <li>
            <span class="badge badge-ghost badge-sm text-muted">{badge}</span>
          </li>
        ))
      }
    </ul>
    <div class="stack-gap">
      <Button href="/contacto/?origen=home&motivo=propuestaComercial" variant="primary" size="lg">
        Solicitar propuesta
      </Button>
    </div>
  </div>
</section>
