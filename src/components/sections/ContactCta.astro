---
import { homeContactoIntro } from '../../content/home';
import styles from './ContactCta.module.css';
import SectionHeader from '../SectionHeader.astro';
---

<section id="contacto" class="section-shell scroll-mt-nav" aria-labelledby="contacto-heading">
  <div
    class:list={[
      'surface-raised',
      'radius-panel',
      'px-6',
      'py-10',
      'sm:px-10',
      'sm:py-12',
      styles.panel
    ]}
    data-contact-panel
  >
    <SectionHeader
      id="contacto-heading"
      eyebrow={homeContactoIntro.eyebrow}
      title={homeContactoIntro.title}
      description={homeContactoIntro.lead}
    />
    <div class="stack-gap">
      <a class="btn btn-primary btn-lg" href="/contacto/?origen=home&motivo=propuestaComercial">
        Solicitar propuesta
      </a>
    </div>
  </div>
</section>
