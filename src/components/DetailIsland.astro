---
/**
 * Isla de ficha: dialog nativo sobre el índice con soft-nav (pushState).
 * Sin JS el enlace de la tarjeta navega a la página [slug] (SEO / deep link).
 */
import Icon from './ui/Icon.astro';

export type DetailIslandItem = {
  slug: string;
  path: string;
  title: string;
  short: string;
  description?: string;
  meta?: string;
  ctaLabel: string;
  ctaHref: string;
};

interface Props {
  basePath: '/servicios' | '/referencias';
  items: DetailIslandItem[];
}

const { basePath, items } = Astro.props;
---

{
  items.map((item) => (
    <dialog
      id={`detail-${basePath.slice(1)}-${item.slug}`}
      class="detail-island m-auto w-[min(100%,36rem)] max-h-[min(90dvh,40rem)] overflow-y-auto overscroll-contain radius-surface border border-border bg-card p-0 text-fg"
      data-detail-island
      data-detail-path={item.path}
      data-detail-base={basePath}
      aria-labelledby={`detail-title-${item.slug}`}
    >
      <div class="sticky top-0 z-10 flex items-start justify-between gap-3 border-b border-border bg-card px-5 py-4">
        <h2 id={`detail-title-${item.slug}`} class="text-step-1 font-bold text-balance pr-2">
          {item.title}
        </h2>
        <button
          type="button"
          class="btn btn-ghost btn-square focus-ring h-11 w-11 shrink-0 text-muted hover:text-fg"
          data-detail-close
          aria-label="Cerrar"
        >
          <Icon name="close" />
        </button>
      </div>
      <div class="space-y-3 px-5 py-4">
        {item.meta ? (
          <p class="font-mono text-step--1 text-muted text-pretty">{item.meta}</p>
        ) : null}
        <p class="text-step--1 text-muted">{item.short}</p>
        <div class="pt-2">
          <a
            href={item.ctaHref}
            class="btn focus-ring inline-flex min-h-11 items-center justify-center gap-2 radius-surface bg-primary px-6 py-3 font-medium text-ink hover:bg-primaryHover"
          >
            {item.ctaLabel}
            <span class="sr-only"> sobre {item.title}</span>
          </a>
          <p class="mt-3 text-step--1 text-muted">
            <a
              href={item.path}
              class="underline decoration-dotted underline-offset-2 hover:text-fg"
              data-detail-fullpage
            >
              Abrir ficha completa<span class="sr-only"> de {item.title}</span>
            </a>
          </p>
        </div>
      </div>
    </dialog>
  ))
}

<style>
  body:has(dialog[open]) {
    overflow: hidden;
  }
</style>

<script>
  import { initDetailIsland } from '../scripts/detailIsland';
  initDetailIsland();
</script>
