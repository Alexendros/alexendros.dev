---
import { site } from '../content/site';
---

<footer
  class="chrome-surface footer gap-6 border-t border-border px-6 py-5 sm:footer-horizontal lg:px-8"
>
  <aside class="gap-1">
    <p class="text-step-0 font-bold leading-tight">Alexendros.dev</p>
    <p class="text-step--1 text-muted leading-snug">
      Servicios informáticos y tecnológicos.<br />Valencia y en remoto.
    </p>
  </aside>
  <nav aria-label="Navegación">
    <h2 class="footer-title chrome-label">Navegación</h2>
    {
      site.nav.map((item) => (
        <a class="link link-hover" href={item.href}>
          {item.label}
        </a>
      ))
    }
    {
      site.footerExtraNav.map((item) => (
        <a class="link link-hover" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <nav aria-label="Legal">
    <h2 class="footer-title chrome-label">Legal</h2>
    {
      site.footerNav.map((item) => (
        <a class="link link-hover" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <nav aria-label="Enlaces">
    <h2 class="footer-title chrome-label">Enlaces</h2>
    <a class="link link-hover" href={site.social.github} rel="noopener">GitHub</a>
    <a class="link link-hover" href={site.social.linkedin} rel="noopener">LinkedIn</a>
    <a class="link link-hover" href={site.social.email}>Correo</a>
  </nav>
</footer>
