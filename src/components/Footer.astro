---
import { site } from '../content/site';
---

<footer class="chrome-surface w-full border-t border-border">
  <div class="footer footer-inner gap-6 py-5 sm:footer-horizontal">
    <aside class="gap-1">
      <p class="text-step-0 font-bold leading-tight">Alexendros.dev</p>
      <p class="text-step--1 text-muted leading-snug">
        Servicios informáticos y tecnológicos.<br />Valencia y en remoto.
      </p>
    </aside>
    <nav aria-label="Navegación">
      <h2 class="footer-title chrome-label">Navegación</h2>
      {
        site.nav.map((item) => (
          <a class="link link-hover" href={item.href}>
            {item.label}
          </a>
        ))
      }
      {
        site.footerExtraNav.map((item) => (
          <a class="link link-hover" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <nav aria-label="Legal">
      <h2 class="footer-title chrome-label">Legal</h2>
      {
        site.footerNav.map((item) => (
          <a class="link link-hover" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <nav aria-label="Enlaces">
      <h2 class="footer-title chrome-label">Enlaces</h2>
      <a
        class="link link-hover footer-social"
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer">GitHub<span class="sr-only"> (abre en otra pestaña)</span></a
      >
      <a
        class="link link-hover footer-social"
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer">LinkedIn<span class="sr-only"> (abre en otra pestaña)</span></a
      >
      <a class="link link-hover footer-social" href={site.social.email}>Correo</a>
    </nav>
  </div>
</footer>
