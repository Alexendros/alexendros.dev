---
import { site } from '../content/site';
const year = new Date().getFullYear();
---

<footer class="footer-veil border-t border-border">
  <div
    class="footer-inner mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 md:flex-row md:items-start md:justify-between"
  >
    <div class="max-w-sm">
      <p class="font-display text-lg font-bold">Alexendros<span class="text-muted">.dev</span></p>
      <p class="mt-3 text-step--1 text-muted">
        Servicios informáticos y tecnológicos. Valencia y en remoto.
      </p>
    </div>
    <div class="flex min-w-0 flex-wrap gap-x-10 gap-y-6">
      <nav aria-label="Navegación" class="flex flex-col gap-2">
        {
          site.nav.map((item) => (
            <a class="link" href={item.href}>
              {item.label}
            </a>
          ))
        }
        {
          site.footerExtraNav.map((item) => (
            <a class="link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav aria-label="Legal" class="flex flex-col gap-2">
        {
          site.footerNav.map((item) => (
            <a class="link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav aria-label="Enlaces" class="flex flex-col gap-2">
        <a
          class="link footer-social"
          href={site.social.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub<span class="sr-only"> (abre en otra pestaña)</span>
        </a>
        <a
          class="link footer-social"
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn<span class="sr-only"> (abre en otra pestaña)</span>
        </a>
        <a class="link footer-social" href={site.social.email}>Correo</a>
      </nav>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-6 py-6 text-step--1 text-muted">
      © {year} Alejandro Domingo Agustí · Alexendros.dev
    </p>
  </div>
</footer>
