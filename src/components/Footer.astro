---
import { site } from '../content/site';
---

<footer class="footer border-t border-base-300 bg-base-100 p-10 sm:footer-horizontal">
  <aside>
    <p class="text-step-1 font-bold">Alexendros.dev</p>
    <p class="text-muted">
      Servicios informáticos y tecnológicos.<br />Valencia y en remoto.
    </p>
  </aside>
  <nav aria-label="Navegación">
    <h2 class="footer-title font-semibold text-fg opacity-100">Navegación</h2>
    {
      site.nav.map((item) => (
        <a class="link link-hover" href={item.href}>
          {item.label}
        </a>
      ))
    }
    {
      site.footerExtraNav.map((item) => (
        <a class="link link-hover" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <nav aria-label="Legal">
    <h2 class="footer-title font-semibold text-fg opacity-100">Legal</h2>
    {
      site.footerNav.map((item) => (
        <a class="link link-hover" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <nav aria-label="Enlaces">
    <h2 class="footer-title font-semibold text-fg opacity-100">Enlaces</h2>
    <a class="link link-hover" href={site.social.github} rel="noopener">GitHub</a>
    <a class="link link-hover" href={site.social.linkedin} rel="noopener">LinkedIn</a>
    <a class="link link-hover" href={site.social.email}>Correo</a>
  </nav>
</footer>
