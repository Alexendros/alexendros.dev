---
import { site } from '../content/site';
import Link from './Link.astro';
import Button from './Button.astro';
import Container from './Container.astro';
import { splitTwoLineLabel } from '../lib/stackedLabel';

const path = Astro.url.pathname;
const contactCta = splitTwoLineLabel('Formulario de contacto');
---

<header id="site-header" class="sticky top-0 z-50 backdrop-blur border-b border-border glass-bg">
  <Container class="h-header flex items-center justify-between gap-4">
    <a href="/" class="font-mono font-bold tracking-tight shrink-0 focus-ring rounded"
      >Alexendros<span class="text-primary">.dev</span></a
    >
    <nav
      class="site-nav hidden lg:flex flex-nowrap items-center justify-end gap-x-5 text-sm font-medium"
      aria-label="Principal"
    >
      {
        site.nav.map((i) => {
          const current = path.startsWith(i.href);
          const stacked = splitTwoLineLabel(i.label);
          return (
            <Link
              href={i.href}
              variant="nav"
              current={current}
              class="inline-flex flex-col items-center text-center leading-tight"
            >
              <span>{stacked.primary}</span>
              {stacked.secondary ? <span>{stacked.secondary}</span> : null}
            </Link>
          );
        })
      }
    </nav>
    <div class="flex items-center gap-2 shrink-0">
      <Button
        href="/contacto"
        size="sm"
        class="hidden min-[360px]:inline-flex text-center leading-tight py-1"
        aria-label="Formulario de contacto"
      >
        <span class="inline-flex flex-col items-center">
          <span>{contactCta.primary}</span>
          {contactCta.secondary ? <span>{contactCta.secondary}</span> : null}
        </span>
      </Button>
      <button
        type="button"
        data-menu-button
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg border border-border hover:border-primary hover:text-primary focus-ring"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <svg
          id="menu-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg
          id="menu-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </Container>
  <nav
    data-mobile-nav
    id="mobile-nav"
    class="lg:hidden border-t border-border"
    aria-label="Principal, móvil"
    hidden
  >
    <ul class="px-6 py-3 flex flex-col gap-1 text-base font-medium">
      {
        site.nav.map((i) => (
          <li>
            <Link href={i.href} variant="nav" current={path.startsWith(i.href)} class="block py-3">
              {i.label}
            </Link>
          </li>
        ))
      }
      <li>
        <Link
          href="/contacto"
          variant="nav"
          current={path.startsWith('/contacto')}
          class="block py-3"
        >
          Formulario de contacto
        </Link>
      </li>
    </ul>
  </nav>
  <span class="reading-progress" aria-hidden="true"></span>
</header>

<script>
  function initMobileNav(): void {
    const menuButton = document.querySelector('[data-menu-button]');
    const mobileNav = document.querySelector('[data-mobile-nav]');
    if (!(menuButton instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const menuLinks = Array.from(mobileNav.querySelectorAll('a'));
    const isMenuOpen = (): boolean => menuButton.getAttribute('aria-expanded') === 'true';
    const focusWithRetry = (el: HTMLElement): void => {
      const tryFocus = (): void => {
        if (document.activeElement !== el) el.focus({ preventScroll: true });
      };
      tryFocus();
      // rAF + timeouts: Enter/Escape y el CMP pueden mover el foco tras el
      // primer paint o al ocultar el nav (el enlace enfocado deja de ser focusable).
      requestAnimationFrame(() => {
        tryFocus();
        requestAnimationFrame(tryFocus);
      });
      for (const ms of [0, 32, 80]) {
        window.setTimeout(tryFocus, ms);
      }
    };
    const setMenuOpen = (open: boolean): void => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      if (open) {
        mobileNav.removeAttribute('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        const first = menuLinks[0];
        if (first) focusWithRetry(first);
      } else {
        mobileNav.setAttribute('hidden', '');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    };
    const restoreMenuButtonFocus = (): void => {
      focusWithRetry(menuButton);
    };
    menuButton.addEventListener('click', () => setMenuOpen(!isMenuOpen()));
    // Escape cierra aunque el foco esté en el botón o fuera del <nav>
    // (p. ej. tras Tab al chrome); el listener en solo mobileNav no bastaba.
    // capture + stopImmediatePropagation evita que el CMP robe Escape/foco.
    document.addEventListener(
      'keydown',
      (event: KeyboardEvent) => {
        if (event.key !== 'Escape' || !isMenuOpen()) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        setMenuOpen(false);
        restoreMenuButtonFocus();
      },
      true
    );
    menuLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
    document.documentElement.dataset.headerReady = 'true';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNav, { once: true });
  } else {
    initMobileNav();
  }
</script>
