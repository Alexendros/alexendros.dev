---
import { site } from '../content/site';
import Icon from './ui/Icon.astro';

const contactHref = '/contacto/?motivo=propuestaComercial';
const pathname = Astro.url.pathname;

function isCurrent(href: string): boolean {
  const base = href.split('?')[0] ?? href;
  if (base === '/') return pathname === '/' || pathname === '';
  return pathname === base || pathname.startsWith(base);
}
---

<header id="site-header" class="chrome-surface sticky top-0 z-50 border-b border-border">
  <div class="navbar-inner navbar">
    <div class="navbar-start">
      <div class="relative lg:hidden">
        <button
          type="button"
          class="btn btn-ghost btn-square h-11 w-11"
          data-menu-button
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <Icon name="menu" />
        </button>
        <nav aria-label="Principal">
          <ul
            id="mobile-nav"
            hidden
            class="menu surface-raised absolute left-0 z-10 mt-3 w-64 radius-surface p-2"
          >
            {
              site.nav.map((item) => (
                <li>
                  <a
                    class="chrome-label"
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <a
        class="btn btn-ghost min-h-11 text-step-0 font-bold tracking-tight sm:text-step-1"
        href="/#top"
      >
        Alexendros<span class="hidden text-sm font-normal opacity-60 sm:inline">.dev</span>
      </a>
    </div>
    <nav class="navbar-center hidden lg:flex" aria-label="Principal">
      <ul class="menu menu-horizontal gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                class="chrome-label"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="navbar-end gap-1">
      {/* theme-controller oculto: el botón cicla y sincroniza el input. */}
      <input type="checkbox" class="theme-controller hidden" value="alexdark" data-theme-input />
      <button
        type="button"
        class="btn btn-ghost btn-square js-only h-11 w-11"
        data-theme-toggle
        aria-label="Tema: sistema. Pulsar para claro"
      >
        <span data-theme-icon="system">
          <Icon name="theme-system" />
        </span>
        <span data-theme-icon="alexlight" hidden>
          <Icon name="sun" />
        </span>
        <span data-theme-icon="alexdark" hidden>
          <Icon name="moon" />
        </span>
      </button>
      <a class="btn btn-primary min-h-11 px-4" href={contactHref}>Contacto</a>
    </div>
  </div>
</header>

<script>
  import { initThemeToggle } from '../scripts/themeToggle';
  import { initMobileMenu } from '../scripts/mobileMenu';
  initThemeToggle();
  initMobileMenu();
</script>
