---
import { site } from '../content/site';
import Icon from './ui/Icon.astro';

const contactHref = '/contacto/?motivo=propuestaComercial';
const pathname = Astro.url.pathname;

function isCurrent(href: string): boolean {
  const base = href.split('?')[0] ?? href;
  if (base === '/') return pathname === '/' || pathname === '';
  return pathname === base || pathname.startsWith(base);
}
---

<header id="site-header" class="chrome-surface sticky top-0 z-50 border-b border-border">
  <div class="header-bar">
    <div class="flex min-w-0 items-center gap-2">
      <div class="relative lg:hidden">
        <button
          type="button"
          class="btn btn-ghost btn-square h-11 w-11"
          data-menu-button
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <Icon name="menu" />
        </button>
        <nav aria-label="Principal">
          <ul
            id="mobile-nav"
            hidden
            class="menu surface-raised absolute left-0 z-[80] mt-3 w-64 radius-surface p-2"
          >
            {
              site.nav.map((item) => (
                <li>
                  <a
                    class:list={[isCurrent(item.href) && 'font-bold']}
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <a
        class="inline-flex min-h-11 items-center font-display text-lg font-bold tracking-tight"
        href="/#top"
      >
        Alexendros<span class="text-muted">.dev</span>
      </a>
    </div>
    <nav class="header-nav hidden lg:flex" aria-label="Principal">
      {
        site.nav.map((item) => (
          <a
            class:list={[
              'text-step--1 hover:text-fg',
              isCurrent(item.href) ? 'font-bold text-fg' : 'text-muted'
            ]}
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-1">
      <input
        type="checkbox"
        class="hidden"
        value="alexdark"
        data-theme-input
        aria-hidden="true"
        tabindex="-1"
      />
      <button
        type="button"
        class="btn btn-ghost btn-square js-only h-11 w-11"
        data-theme-toggle
        aria-label="Tema: sistema"
      >
        <span data-theme-icon="system">
          <Icon name="theme-system" />
        </span>
        <span data-theme-icon="alexlight" hidden>
          <Icon name="sun" />
        </span>
        <span data-theme-icon="alexdark" hidden>
          <Icon name="moon" />
        </span>
      </button>
      <a class="btn btn-primary min-h-11 px-4" href={contactHref}>Contacto</a>
    </div>
  </div>
</header>
