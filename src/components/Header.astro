---
import { site } from '../content/site';
import Icon from './ui/Icon.astro';
import styles from './Header.module.css';

const contactHref = '/contacto/?motivo=propuestaComercial';
---

<header
  id="site-header"
  class:list={['navbar sticky top-0 z-50 border-b border-border px-3 lg:px-8', styles.header]}
>
  <div class="navbar-start">
    <div class="relative lg:hidden">
      <button
        type="button"
        class="btn btn-ghost btn-square h-11 w-11"
        data-menu-button
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" />
      </button>
      <ul
        id="mobile-nav"
        hidden
        class="menu surface-raised absolute left-0 z-10 mt-3 w-64 rounded-xl p-2"
      >
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <a class="btn btn-ghost text-step-0 font-bold tracking-tight sm:text-step-1" href="/#top">
      Alexendros<span class="hidden text-sm font-normal opacity-60 sm:inline">.dev</span>
    </a>
  </div>
  <nav class="navbar-center hidden lg:flex" aria-label="Principal">
    <ul class="menu menu-horizontal gap-1">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="navbar-end gap-1">
    {/* theme-controller oculto: el botón cicla y sincroniza el input. */}
    <input type="checkbox" class="theme-controller hidden" value="alexdark" data-theme-input />
    <button
      type="button"
      class="btn btn-ghost btn-circle js-only h-11 w-11"
      data-theme-toggle
      aria-label="Tema: sistema. Pulsar para cambiar"
    >
      <Icon name="theme" />
    </button>
    <a class="btn btn-primary btn-sm min-h-11 px-3 sm:btn-md sm:px-4" href={contactHref}>Contacto</a
    >
  </div>
</header>

<script>
  import { initThemeToggle } from '../scripts/themeToggle';
  import { initMobileMenu } from '../scripts/mobileMenu';
  initThemeToggle();
  initMobileMenu();
</script>
