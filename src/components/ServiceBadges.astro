---
import styles from './ServiceBadges.module.css';

interface Props {
  timeline: string;
  delivery: string;
  guarantee: string;
}

const { timeline, delivery, guarantee } = Astro.props;
---

<dl class={styles.group} data-product-section="commercial" data-service-badges>
  <div class={styles.badge} data-service-badge>
    <dt>Plazo</dt>
    <dd>{timeline}</dd>
  </div>
  <div class="border border-border rounded-lg p-4 bg-card sm:col-span-2">
    <dt class="text-muted">Entrega</dt>
    <dd class="font-medium mt-1">{delivery}</dd>
  </div>
  <div class={styles.badge} data-service-badge>
    <dt>Garantía</dt>
    <dd>{guarantee}</dd>
  </div>
</dl>
