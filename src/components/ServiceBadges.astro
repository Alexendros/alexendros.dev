---
import styles from './ServiceBadges.module.css';

interface Props {
  timeline: string;
  delivery: string;
  guarantee: string;
}

const { timeline, delivery, guarantee } = Astro.props;
---

<dl class={styles.group} data-next-step-facts>
  <div class={styles.pair}>
    <dt>Plazo</dt>
    <dd>{timeline}</dd>
  </div>
  <div class={styles.pair}>
    <dt>Entrega</dt>
    <dd>{delivery}</dd>
  </div>
  <div class={styles.pair}>
    <dt>Garantía</dt>
    <dd>{guarantee}</dd>
  </div>
</dl>
