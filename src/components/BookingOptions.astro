---
import { contact } from '../content/contact';
import { qrSvg } from '../lib/qrSvg';

const offers = contact.bookings.offers.map((offer) =>
  offer.kind === 'cal' ? { ...offer, qrMarkup: qrSvg(offer.url) } : { ...offer, qrMarkup: null }
);
---

<section id="reservar" class="mt-10" aria-labelledby="reservar-heading">
  <h2 id="reservar-heading" class="text-2xl font-bold">{contact.bookings.heading}</h2>
  <p class="text-muted mt-2">{contact.bookings.intro}</p>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    {
      offers.map((offer) => (
        <article class="border border-border rounded-lg p-6 bg-card flex flex-col sm:flex-row gap-6">
          <div class="min-w-0 flex-1">
            <h3 class="font-bold text-lg leading-tight">{offer.title}</h3>
            <p class="mt-1 font-medium text-primary">{offer.priceLabel}</p>
            <p class="mt-2 text-sm text-muted">{offer.summary}</p>
            {offer.kind === 'form' ? (
              <a
                href={offer.href}
                class="mt-4 inline-flex bg-primary text-ink px-5 py-2.5 rounded-lg font-medium focus-ring whitespace-nowrap"
              >
                {offer.cta}
              </a>
            ) : (
              <a
                href={offer.url}
                class="mt-4 inline-flex bg-primary text-ink px-5 py-2.5 rounded-lg font-medium focus-ring whitespace-nowrap"
                data-cal-link={offer.calLink}
                data-cal-config='{"layout":"month_view","theme":"dark"}'
                target="_blank"
                rel="noopener noreferrer"
              >
                {offer.cta}
              </a>
            )}
          </div>
          {offer.kind === 'cal' && offer.qrMarkup && (
            <figure class="m-0 shrink-0 text-center sm:w-32">
              <a
                href={offer.url}
                class="inline-block rounded-xl focus-ring"
                data-cal-link={offer.calLink}
                data-cal-config='{"layout":"month_view","theme":"dark"}'
                target="_blank"
                rel="noopener noreferrer"
                aria-label={offer.qrLabel}
              >
                <span
                  class="block h-28 w-28 rounded-xl bg-white p-2"
                  aria-hidden="true"
                  set:html={offer.qrMarkup}
                />
              </a>
              <figcaption class="mt-2 text-xs text-muted">{contact.bookings.scanLabel}</figcaption>
            </figure>
          )}
        </article>
      ))
    }
  </div>
</section>

<script>
  import { setupCalBookingTriggers } from '../lib/calEmbed';
  setupCalBookingTriggers();
</script>
