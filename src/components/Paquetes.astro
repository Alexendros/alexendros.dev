---
import {
  paquetesVisibles,
  precioTexto,
  plazoTexto,
  paqueteContactoHref
} from '../content/paquetes';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const visibles = paquetesVisibles();
---

{
  visibles.length > 0 ? (
    <div class="stack-block grid gap-6 md:grid-cols-3" data-paquetes>
      {visibles.map((p) => (
        <article class="card surface-raised radius-surface" data-paquete={p.id}>
          <div class="card-body gap-4">
            <Heading class="card-title text-step-1 leading-tight">{p.nombre}</Heading>
            <p class="text-muted">{p.paraQuien}</p>
            <ul class="list-disc space-y-1 ps-5 text-step--1">
              {p.incluye.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="text-step-1 font-bold text-primary" data-paquete-precio>
              {precioTexto(p)}
            </p>
            <p class="text-step--1 font-semibold">
              {plazoTexto(p)} · {p.mantenimiento}
            </p>
            <p class="text-step--1 text-muted" data-paquete-letra>
              {p.letraPequena}
            </p>
            <div class="card-actions mt-auto">
              <a
                class="btn btn-primary btn-block"
                href={paqueteContactoHref(p)}
                data-pick-via={p.id}
              >
                Pedir el paquete<span class="sr-only"> {p.nombre}</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : null
}
