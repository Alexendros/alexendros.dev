---
import Button from './Button.astro';
import { processPage } from '../content/process';
import { resolveStickyCta } from '../lib/stickyCta';
import { splitTwoLineLabel } from '../lib/stackedLabel';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const currentPath = Astro.url.pathname || pathname;
const cta = resolveStickyCta(currentPath, processPage.close);
const stacked = splitTwoLineLabel(cta.label);
---

{
  cta.show && (
    <div
      id="sticky-cta"
      class:list={[
        'fixed bottom-0 left-0 right-0 z-30 border-t border-border glass-card backdrop-blur pb-safe',
        cta.mobileOnly && 'md:hidden',
        cta.alwaysVisible && 'is-visible'
      ]}
      role="region"
      aria-label={cta.label}
      aria-hidden={cta.alwaysVisible ? 'false' : 'true'}
      data-sticky-mode={cta.mode}
    >
      <div class="mx-auto flex w-full max-w-[var(--container)] min-w-0 items-center justify-between gap-2 px-[var(--gutter)] py-3">
        {cta.body ? (
          <p class="min-w-0 flex-1 truncate text-xs text-muted">{cta.body}</p>
        ) : (
          <span class="min-w-0 flex-1" aria-hidden="true" />
        )}
        <div class="flex shrink-0 items-center gap-1">
          <Button
            href={cta.href}
            id="sticky-cta-link"
            size="sm"
            class="text-center leading-tight py-1"
            tabindex={cta.alwaysVisible ? 0 : -1}
          >
            <span class="inline-flex flex-col items-center whitespace-pre-line text-center">
              {stacked.secondary ? `${stacked.primary}\n${stacked.secondary}` : stacked.primary}
            </span>
          </Button>
          <button
            id="sticky-cta-dismiss"
            type="button"
            class="shrink-0 rounded-lg p-1.5 text-muted transition-colors hover:text-fg focus-ring"
            aria-label="Cerrar"
            tabindex={cta.alwaysVisible ? 0 : -1}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  )
}

<script is:inline>
  (function () {
    const THRESHOLD = 400;
    const banner = document.getElementById('sticky-cta');
    if (!banner) return;
    const dismissBtn = document.getElementById('sticky-cta-dismiss');
    const ctaBtn = document.getElementById('sticky-cta-link');
    const alwaysVisible = banner.getAttribute('data-sticky-mode') === 'metodo';
    const STORAGE_KEY = alwaysVisible
      ? 'alexendros.sticky-cta.metodo.v1'
      : 'alexendros.sticky-cta.v1';
    let shown = alwaysVisible;
    let dismissed = false;
    let ticking = false;

    function track(name) {
      const va = window.va;
      if (va && typeof va.track === 'function') va.track(name);
    }

    function isDismissed() {
      try {
        return localStorage.getItem(STORAGE_KEY) === '1';
      } catch {
        return false;
      }
    }

    function setDismissed() {
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch {
        /* almacenamiento no disponible */
      }
    }

    function detachScroll() {
      window.removeEventListener('scroll', onScroll);
    }

    function setInteractive(on) {
      banner.setAttribute('aria-hidden', on ? 'false' : 'true');
      if (ctaBtn) ctaBtn.tabIndex = on ? 0 : -1;
      if (dismissBtn) dismissBtn.tabIndex = on ? 0 : -1;
    }

    function showBanner() {
      if (shown || dismissed || isDismissed()) return;
      shown = true;
      detachScroll();
      banner.classList.add('is-visible');
      setInteractive(true);
      track('sticky_cta_impression');
    }

    function hideBanner() {
      dismissed = true;
      detachScroll();
      banner.classList.remove('is-visible');
      setInteractive(false);
      setDismissed();
      track('sticky_cta_dismiss');
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        ticking = false;
        if (window.scrollY < THRESHOLD) return;
        showBanner();
      });
    }

    function init() {
      if (isDismissed()) {
        banner.classList.remove('is-visible');
        setInteractive(false);
        return;
      }
      if (ctaBtn) {
        ctaBtn.addEventListener('click', function () {
          track('sticky_cta_cta_click');
        });
      }
      if (dismissBtn) dismissBtn.addEventListener('click', hideBanner);
      if (alwaysVisible) {
        setInteractive(true);
        track('sticky_cta_impression');
        return;
      }
      if (window.scrollY >= THRESHOLD) {
        showBanner();
      } else {
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
