---
import type { ProductCard } from '../content/services';
import Icon from './ui/Icon.astro';

interface Props {
  product: ProductCard;
  /** h2 en índices (bajo h1), h3 en demos (bajo h2 de sección) */
  headingLevel?: 'h2' | 'h3';
}
const { product, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article
  class="card-lift group relative border border-border rounded-xl bg-card p-6 flex flex-col h-full has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-focus has-[:focus-visible]:outline-offset-2"
  data-product-card={product.slug}
>
  <Heading
    class="mt-1 text-step-1 font-semibold leading-tight group-hover:text-primary transition-colors"
    data-product-card-title
  >
    <a href={product.href} class="rounded after:absolute after:inset-0">
      {product.title}
    </a>
  </Heading>
  <p class="mt-3 text-step--1 text-muted" data-product-card-summary>{product.short}</p>
  <div
    class="mt-auto pt-4 text-sm font-medium text-primary"
    aria-hidden="true"
    data-product-card-cta
  >
    {product.ctaLabel}
    <span
      class="inline-block transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:transform-none"
    >
      <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>
