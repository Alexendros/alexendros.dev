---
import type { ProductCard } from '../content/services';

interface Props {
  product: ProductCard;
  /** h2 en índices (bajo h1), h3 en demos (bajo h2 de sección) */
  headingLevel?: 'h2' | 'h3';
}
const { product, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article
  class="card-lift group relative border border-border rounded-lg p-6 hover:border-primarySoft bg-card flex flex-col h-full focus-within:outline focus-within:outline-2 focus-within:outline-primary focus-within:outline-offset-2"
  data-product-card={product.slug}
>
  <Heading
    class="font-bold text-lg leading-tight mt-1 group-hover:text-primary transition-colors"
    data-product-card-title
  >
    <a href={product.href} class="rounded after:absolute after:inset-0">
      {product.title}
    </a>
  </Heading>
  <p class="mt-3 text-sm text-muted" data-product-card-summary>{product.short}</p>
  <p class="mt-4 text-sm text-muted" data-product-card-price>
    {product.priceLabel}
  </p>
  <div class="mt-auto pt-4 text-sm font-medium" aria-hidden="true" data-product-card-cta>
    {product.ctaLabel}
  </div>
</article>
