---
import { homeVias } from '../content/home';
import { paquetesPublicados, paquetesVisibles } from '../content/paquetes';
import { portalModuleDisplayNames, type ContactInput } from '../lib/contactSchema';
import { site } from '../content/site';
import Icon from './ui/Icon.astro';
import styles from './ContactForm.module.css';

type ViaIcon = 'file' | 'layers' | 'flag' | 'check';

const VIA_ICONS: Record<string, ViaIcon> = {
  revisar: 'file',
  crear: 'layers',
  colaborar: 'flag',
  otra: 'check',
  web: 'layers',
  tienda: 'layers',
  asistente: 'flag',
  automatizacion: 'flag'
};

interface Props {
  successMessage: string;
  errorMessage: string;
  initialReason?: ContactInput['reason'];
  initialOrigin?: ContactInput['origin'] | '';
  initialServiceSlug?: string;
  initialProjectSlug?: string;
  initialModules?: string;
  initialVia?: string;
}

const {
  successMessage,
  errorMessage,
  initialReason = 'informacionCliente',
  initialOrigin = '',
  initialServiceSlug = '',
  initialProjectSlug = '',
  initialModules = '',
  initialVia = ''
} = Astro.props;
const moduleLabels = initialModules ? portalModuleDisplayNames(initialModules) : '';
const vias = [
  ...(paquetesPublicados
    ? paquetesVisibles().map((p) => ({ id: p.id, label: p.nombre, hint: p.paraQuien }))
    : homeVias.map((v) => ({ id: v.id, label: v.formLabel, hint: v.formHint }))),
  {
    id: 'otra' as const,
    label: 'Otra necesidad',
    hint: 'Algo que no encaja en las anteriores'
  }
];
---

<p
  role="status"
  tabindex="-1"
  class:list={[
    'focus-ring mb-4 radius-surface border border-success bg-card p-4 text-success focus:outline-none',
    styles.toast
  ]}
  data-contact-success
  data-success-message={successMessage}
  hidden
>
</p>

<form
  class="relative space-y-5"
  novalidate
  aria-busy="false"
  aria-labelledby="contact-page-heading"
  data-contact-form
>
  <div class="honeypot" aria-hidden="true" inert>
    <label for="contact-website">Sitio web</label>
    <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" id="contact-reason" name="reason" value={initialReason} />
  <input type="hidden" id="contact-entity" name="entityType" value="particular" />
  <input type="hidden" id="contact-service" name="serviceSlug" value={initialServiceSlug} />
  <input type="hidden" id="contact-project" name="projectSlug" value={initialProjectSlug} />
  <input type="hidden" name="origin" value={initialOrigin} />
  <input type="hidden" name="modules" value={initialModules} />
  <input type="hidden" name="channel" value="correo" />

  <p class="text-step--1 text-muted" data-contact-modules hidden={!moduleLabels}>
    Módulos indicados:{' '}
    <strong class="opacity-100" data-contact-module-labels>{moduleLabels}</strong>
  </p>

  <fieldset
    class="fieldset min-w-0"
    id="contact-ways"
    data-contact-ways
    aria-label="Opciones para empezar"
  >
    <div class="grid grid-cols-1 gap-2">
      {
        vias.map((via) => (
          <label
            class:list={[
              'relative flex min-w-0 min-h-11 cursor-pointer items-start gap-3 radius-surface border border-border p-3 hover:border-primary has-checked:border-primary has-checked:bg-brand-soft',
              styles['via-option']
            ]}
          >
            <input
              type="checkbox"
              name="via"
              value={via.id}
              id={via.id === 'otra' ? 'contact-via-otra' : `contact-via-${via.id}`}
              class={styles['via-input']}
              data-via={via.id}
              checked={initialVia === via.id || undefined}
              aria-controls={via.id === 'otra' ? 'contact-otra-wrap' : undefined}
              aria-expanded={via.id === 'otra' ? 'false' : undefined}
            />
            <span class={styles['via-mark']} data-via-mark aria-hidden="true">
              <Icon name={VIA_ICONS[via.id] ?? 'check'} size={22} />
            </span>
            <span class="min-w-0">
              <span class="block min-w-0 font-medium">{via.label}</span>
              <span class="mt-0.5 block text-step--1 text-muted">{via.hint}</span>
            </span>
          </label>
        ))
      }
    </div>
    <div class="mt-2" id="contact-otra-wrap" data-otra-wrap hidden>
      <label class="sr-only" for="contact-otra">Describir la otra necesidad</label>
      <input
        id="contact-otra"
        name="otraDetalle"
        class="input w-full"
        maxlength="120"
        minlength="3"
        placeholder="Describir la otra necesidad"
        aria-describedby="contact-otra-error"
      />
      <p id="contact-otra-error" role="alert" class="mt-1 text-step--1 text-danger" hidden></p>
    </div>
    <p id="contact-vias-error" role="alert" class="mt-1 text-step--1 text-danger" hidden></p>
  </fieldset>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2" data-contact-fields>
    <div class="grid min-w-0 gap-5">
      <fieldset class:list={['fieldset min-w-0', styles['req-field']]}>
        <label class="fieldset-legend" for="contact-name">
          Nombre completo<span
            class:list={['text-muted text-step--1', styles['req-hint']]}
            aria-hidden="true">obligatorio</span
          >
        </label>
        <input
          id="contact-name"
          name="name"
          autocomplete="name"
          class="input validator w-full"
          required
          minlength="2"
          aria-required="true"
          aria-describedby="contact-name-error"
        />
        <p
          id="contact-name-error"
          role="alert"
          class="validator-hint mt-1 text-step--1 text-danger"
          hidden
        >
        </p>
      </fieldset>

      <fieldset class:list={['fieldset min-w-0', styles['req-field']]} data-contact-email-wrapper>
        <label class="fieldset-legend" for="contact-email">
          Correo electrónico<span
            class:list={['text-muted text-step--1', styles['req-hint']]}
            aria-hidden="true">obligatorio</span
          >
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          class="input validator w-full"
          required
          aria-required="true"
          aria-describedby="contact-email-error"
        />
        <p
          id="contact-email-error"
          role="alert"
          class="validator-hint mt-1 text-step--1 text-danger"
          hidden
        >
        </p>
      </fieldset>
    </div>

    <div class="grid min-w-0 gap-5">
      <fieldset class="fieldset min-w-0">
        <label class="fieldset-legend" for="contact-phone">Teléfono móvil</label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          class="input validator w-full"
          maxlength="40"
          aria-describedby="contact-phone-error"
        />
        <p
          id="contact-phone-error"
          role="alert"
          class="validator-hint mt-1 text-step--1 text-danger"
          hidden
        >
        </p>
      </fieldset>

      <fieldset class="fieldset min-w-0">
        <label class="fieldset-legend" for="contact-sitio">Sitio web actual</label>
        <input
          id="contact-sitio"
          name="sitio"
          class="input validator w-full"
          inputmode="url"
          autocomplete="url"
          pattern="(https?://)?[^\s/.]+(\.[^\s/.]+)+(/\S*)?"
          aria-describedby="contact-sitio-error"
        />
        <p
          id="contact-sitio-error"
          role="alert"
          class="validator-hint mt-1 text-step--1 text-danger"
          hidden
        >
        </p>
      </fieldset>
    </div>
  </div>

  <fieldset class:list={['fieldset min-w-0', styles['req-field']]}>
    <label class="fieldset-legend" for="contact-message">
      Mensaje<span class:list={['text-muted text-step--1', styles['req-hint']]} aria-hidden="true"
        >obligatorio</span
      >
    </label>
    <textarea
      id="contact-message"
      name="message"
      class="textarea validator h-32 w-full"
      required
      minlength="10"
      maxlength="1500"
      placeholder="Qué se necesita, para cuándo y enlaces de referencia."
      aria-required="true"
      aria-describedby="contact-message-error contact-message-count"></textarea>
    <p
      id="contact-message-error"
      role="alert"
      class="validator-hint mt-1 text-step--1 text-danger"
      hidden
    >
    </p>
    <p class="mt-1 text-end text-step--1 text-muted">
      <span aria-live="polite" id="contact-message-count" data-message-count>0 / 1500</span>
    </p>
  </fieldset>

  <label
    class="inline-flex min-h-11 max-w-full items-center gap-x-3 text-step--1"
    for="contact-consent"
  >
    <input
      id="contact-consent"
      type="checkbox"
      name="consent"
      class={`checkbox shrink-0 ${styles['consent-check']}`}
      required
    />
    <span class="min-w-0">
      Acepto el tratamiento de mis datos para responder a esta solicitud según la{' '}
      <a href="/privacidad/" class="link underline underline-offset-2">política de privacidad</a>.
    </span>
  </label>
  <p id="contact-consent-error" role="alert" class="text-step--1 text-danger" hidden></p>

  <div role="alert" class="space-y-1 text-step--1 text-danger" data-contact-errors hidden>
    <p data-contact-error-count></p>
    <ul class="list-disc pl-5" data-contact-error-list></ul>
  </div>

  <p role="alert" class="text-step--1 text-danger" data-contact-status="error" hidden>
    {errorMessage} Alternativa:{' '}
    <a href="mailto:contratacion@alexendros.dev" class="link">contratacion@alexendros.dev</a>.
  </p>
  <p role="alert" class="text-step--1 text-danger" data-contact-status="rate_limited" hidden>
    Demasiados intentos. Esperar un minuto antes de reintentar, o escribir a{' '}
    <a href="mailto:contratacion@alexendros.dev" class="link">contratacion@alexendros.dev</a>.
  </p>
  <p role="alert" class="text-step--1 text-danger" data-contact-status="unavailable" hidden>
    Servicio temporalmente no disponible. Contacto:{' '}
    <a href="mailto:contratacion@alexendros.dev" class="link">contratacion@alexendros.dev</a>.
  </p>
  <p role="status" class="text-step--1 text-muted" data-contact-status="processing" hidden>
    La petición se está procesando. Esperar unos segundos antes de reintentar; no se confirma aún la
    recepción.
  </p>
  <p role="alert" class="text-step--1 text-danger" data-contact-status="conflict" hidden>
    Esta petición no coincide con un envío anterior. Comprobar los datos o escribir a{' '}
    <a href="mailto:contratacion@alexendros.dev" class="link">contratacion@alexendros.dev</a>.
  </p>
  <p role="alert" class="text-step--1 text-danger" data-contact-status="unknown" hidden>
    No se puede confirmar si el mensaje llegó. Evitar reenvío inmediato; esperar un momento o
    escribe a <a href="mailto:contratacion@alexendros.dev" class="link"
      >contratacion@alexendros.dev</a
    >.
  </p>
  <p role="alert" class="text-step--1 text-danger" data-contact-status="timeout" hidden>
    La respuesta tarda más de lo esperado. No sabemos si el mensaje llegó: espera un momento antes
    de reintentar o escribe a{' '}
    <a href="mailto:contratacion@alexendros.dev" class="link">contratacion@alexendros.dev</a>.
  </p>
  <p role="status" class="text-step--1 text-muted" data-contact-status="loading" hidden>
    Enviando la solicitud…
  </p>

  <button type="submit" class="btn btn-primary btn-block btn-lg" data-contact-submit>
    Solicitar propuesta
  </button>
</form>

<noscript>
  <p data-contact-nojs class="mt-6 surface-inset p-4 text-step--1">
    El formulario interactivo necesita JavaScript. Mientras tanto también se puede escribir a{' '}
    <a href={site.social.email} class="link">contratacion@alexendros.dev</a>.
  </p>
</noscript>

<p data-contact-fallback hidden class="mt-6 surface-inset p-4 text-step--1">
  El formulario interactivo necesita JavaScript y no se ha cargado. Mientras tanto también se puede
  escribir a{' '}
  <a href={site.social.email} class="link">contratacion@alexendros.dev</a>.
</p>

<script>
  import '../scripts/contactForm';
</script>
