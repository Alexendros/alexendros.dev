---
import { contactChannels, portalModuleDisplayNames, type ContactInput } from '../lib/contactSchema';

interface Props {
  successMessage: string;
  errorMessage: string;
  turnstileSiteKey?: string;
  initialReason?: ContactInput['reason'];
  initialOrigin?: ContactInput['origin'] | '';
  initialServiceSlug?: string;
  initialProjectSlug?: string;
  initialModules?: string;
}

const {
  successMessage,
  errorMessage,
  turnstileSiteKey,
  initialReason = 'informacionCliente',
  initialOrigin = '',
  initialServiceSlug = '',
  initialProjectSlug = '',
  initialModules = ''
} = Astro.props;
const inputClass =
  'focus-ring mt-1 w-full bg-bg border border-border-strong rounded-lg px-3 py-2 focus:outline-none';
const errorClass = 'mt-1 text-sm text-danger';
const moduleLabels = initialModules ? portalModuleDisplayNames(initialModules) : '';
---

<p
  role="status"
  tabindex="-1"
  class="focus-ring rounded-lg border border-primarySoft bg-primaryGhost p-4 text-sm focus:outline-none"
  data-contact-success
  data-success-message={successMessage}
  hidden
>
</p>

<form class="relative space-y-4" novalidate aria-busy="false" data-contact-form>
  <h2
    id="contact-form-heading"
    tabindex="-1"
    class="focus-ring text-base font-bold focus:outline-none"
  >
    La petición
  </h2>

  <div class="honeypot" aria-hidden="true">
    <label for="contact-website">Sitio web</label>
    <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" id="contact-reason" name="reason" value={initialReason} />
  <input type="hidden" id="contact-entity" name="entityType" value="particular" />
  <input type="hidden" id="contact-service" name="serviceSlug" value={initialServiceSlug} />
  <input type="hidden" id="contact-project" name="projectSlug" value={initialProjectSlug} />
  <input type="hidden" name="origin" value={initialOrigin} />
  <input type="hidden" name="modules" value={initialModules} />

  {
    moduleLabels && (
      <p class="text-sm text-muted" data-contact-modules>
        Módulos indicados:{' '}
        <strong class="text-fg" data-contact-module-labels>
          {moduleLabels}
        </strong>
      </p>
    )
  }

  <div>
    <label for="contact-message" class="text-sm">Mensaje*</label>
    <textarea
      id="contact-message"
      name="message"
      rows="5"
      class={inputClass}
      aria-required="true"
      placeholder="Descripción del encargo o de la consulta."></textarea>
    <p id="contact-message-error" role="alert" class={errorClass} hidden></p>
  </div>

  <div>
    <label for="contact-name" class="text-sm">Nombre*</label>
    <input
      id="contact-name"
      name="name"
      autocomplete="name"
      class={inputClass}
      aria-required="true"
    />
    <p id="contact-name-error" role="alert" class={errorClass} hidden></p>
  </div>

  <fieldset
    id="contact-channel"
    tabindex="-1"
    class="focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  >
    <legend class="text-sm">Preferencia de respuesta*</legend>
    <div class="mt-2 flex flex-wrap gap-4">
      {
        contactChannels.map((channel) => (
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="channel" value={channel} checked={channel === 'correo'} />
            {channel === 'whatsapp' ? 'WhatsApp' : 'Correo electrónico'}
          </label>
        ))
      }
    </div>
    <p id="contact-channel-error" role="alert" class={errorClass} hidden></p>
  </fieldset>

  <div data-contact-phone-wrapper hidden>
    <label for="contact-phone" class="text-sm">Teléfono WhatsApp*</label>
    <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={inputClass} />
    <p id="contact-phone-error" role="alert" class={errorClass} hidden></p>
  </div>

  <div data-contact-email-wrapper>
    <label for="contact-email" class="text-sm">Correo electrónico*</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" class={inputClass} />
    <p id="contact-email-error" role="alert" class={errorClass} hidden></p>
  </div>

  <label class="flex items-start gap-2 text-sm" for="contact-consent">
    <input id="contact-consent" type="checkbox" name="consent" class="mt-1" />
    <span>
      Acepto el tratamiento de mis datos para responder a esta petición según la{' '}
      <a href="/privacidad" class="underline decoration-dotted underline-offset-2">
        política de privacidad
      </a>
      .
    </span>
  </label>
  <p id="contact-consent-error" role="alert" class={errorClass} hidden></p>

  {turnstileSiteKey && <div class="cf-turnstile" data-turnstile data-site-key={turnstileSiteKey} />}

  <div role="alert" class="space-y-1 text-sm text-danger" data-contact-errors hidden>
    <p data-contact-error-count></p>
    <ul class="list-disc pl-5" data-contact-error-list></ul>
  </div>

  <p role="alert" class="text-sm text-danger" data-contact-status="error" hidden>
    {errorMessage} Alternativa:{' '}
    <a
      href="mailto:contratacion@alexendros.dev"
      class="underline decoration-dotted underline-offset-2"
    >
      contratacion@alexendros.dev
    </a>
    .
  </p>
  <p role="alert" class="text-sm text-danger" data-contact-status="rate_limited" hidden>
    Demasiados intentos. Esperar un minuto antes de reintentar, o escribir a{' '}
    <a
      href="mailto:contratacion@alexendros.dev"
      class="underline decoration-dotted underline-offset-2"
    >
      contratacion@alexendros.dev
    </a>
    .
  </p>
  <p role="alert" class="text-sm text-danger" data-contact-status="unavailable" hidden>
    Servicio temporalmente no disponible. Contacto:{' '}
    <a
      href="mailto:contratacion@alexendros.dev"
      class="underline decoration-dotted underline-offset-2"
    >
      contratacion@alexendros.dev
    </a>
    .
  </p>
  <p role="status" class="text-sm text-muted" data-contact-status="processing" hidden>
    La petición se está procesando. Esperar unos segundos antes de reintentar; no se confirma aún la
    recepción.
  </p>
  <p role="alert" class="text-sm text-danger" data-contact-status="conflict" hidden>
    Esta petición no coincide con un envío anterior. Comprobar los datos o escribir a{' '}
    <a
      href="mailto:contratacion@alexendros.dev"
      class="underline decoration-dotted underline-offset-2"
    >
      contratacion@alexendros.dev
    </a>
    .
  </p>
  <p role="alert" class="text-sm text-danger" data-contact-status="unknown" hidden>
    No se puede confirmar si el mensaje llegó. Evitar reenvío inmediato; esperar un momento o
    escribe a{' '}
    <a
      href="mailto:contratacion@alexendros.dev"
      class="underline decoration-dotted underline-offset-2"
    >
      contratacion@alexendros.dev
    </a>
    .
  </p>
  <p role="alert" class="text-sm text-danger" data-contact-status="timeout" hidden>
    La respuesta tarda más de lo esperado. No sabemos si el mensaje llegó: espera un momento antes
    de reintentar o escribe a{' '}
    <a
      href="mailto:contratacion@alexendros.dev"
      class="underline decoration-dotted underline-offset-2"
    >
      contratacion@alexendros.dev
    </a>
    .
  </p>
  <p role="status" class="text-sm text-muted" data-contact-status="loading" hidden>
    Enviando la petición…
  </p>

  <button
    type="submit"
    class="btn focus-ring inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3 font-medium text-ink transition-colors hover:bg-primaryHover disabled:opacity-60"
    data-contact-submit
  >
    Enviar
  </button>
</form>

<script>
  import '../scripts/contactForm';
</script>
