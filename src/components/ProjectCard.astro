---
import { Image } from 'astro:assets';
import { productTypeLabels, type Project } from '../content/projects';
import Icon from './ui/Icon.astro';

interface Props {
  project: Project;
  /** h2 en indices (bajo h1), h3 en home (bajo h2 de seccion) */
  headingLevel?: 'h2' | 'h3';
  /** Carga inmediata (LCP) para la primera tarjeta visible del indice */
  priority?: boolean;
}
const { project, headingLevel = 'h2', priority = false } = Astro.props;
const Heading = headingLevel;
---

<article
  class="card-lift group relative border border-border rounded-xl overflow-hidden bg-card flex flex-col h-full has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-primary has-[:focus-visible]:outline-offset-2"
>
  <Image
    src={project.cover}
    alt={project.coverAlt}
    widths={[400, 800]}
    sizes="(max-width: 768px) 100vw, 400px"
    class="card-img w-full aspect-[16/10] object-cover border-b border-border"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
  <div class="p-6 flex-1 flex flex-col">
    <Heading
      class="mt-1 text-step-1 font-semibold leading-tight group-hover:text-primary transition-colors"
    >
      <a href={`/referencias/${project.slug}/`} class="rounded after:absolute after:inset-0">
        {project.title}
      </a>
    </Heading>
    <span
      class="badge badge-outline badge-sm mt-3 self-start font-mono font-normal text-muted"
      data-project-type
    >
      {productTypeLabels[project.productType]}
    </span>
    <p class="mt-2 text-step--1 text-muted">{project.short}</p>
    {
      project.metrics && project.metrics.length > 0 && (
        <p class="mt-2 text-xs font-medium text-primary">
          {project.metrics[0].value} · {project.metrics[0].label}
        </p>
      )
    }
    <div
      class="mt-auto pt-4 text-sm font-medium text-primary"
      aria-hidden="true"
      data-project-card-cta
    >
      Conocer más
      <span
        class="inline-block transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:transform-none"
      >
        <Icon name="arrow-right" size={16} />
      </span>
    </div>
  </div>
</article>
