---
// Cabecera de página: título, regla hairline y descripción opcional.
// El kicker mono (ÍNDICE · …, CONTACTO, etc.) queda fuera del patrón vivo.
import Eyebrow from './Eyebrow.astro';

interface Props {
  kicker?: string;
  title: string;
  description?: string;
}
const { kicker, title, description } = Astro.props;
---

<div>
  {kicker ? <Eyebrow>{kicker}</Eyebrow> : null}
  <h1 class:list={[kicker ? 'mt-2' : null, 'text-step-4 font-bold max-w-3xl text-balance']}>
    {title}
  </h1>
  <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
  {description && <p class="text-muted mt-3 max-w-2xl">{description}</p>}
</div>
