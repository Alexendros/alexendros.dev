---
import styles from './PageHead.module.css';

interface Props {
  kicker?: string;
  title?: string;
  description?: string;
  titleId?: string;
  /** Amplía el max-width del H1 (p. ej. catálogo de servicios). */
  wide?: boolean;
  /**
   * Centra H1, regla y descripción (mismo ritmo que Metodología).
   * Desactivar en páginas con descripción estructurada (p. ej. contacto).
   */
  centered?: boolean;
}
const { kicker, title, description, titleId, wide = false, centered = true } = Astro.props;
---

<div class:list={[centered && styles.centered]}>
  {kicker ? <p class="eyebrow">{kicker}</p> : null}
  <h1
    id={titleId}
    tabindex={titleId ? -1 : undefined}
    class:list={[
      styles.title,
      kicker && styles['title-spaced'],
      titleId ? 'focus-ring focus:outline-none' : null,
      wide && styles['title-wide'],
      centered && styles['title-centered']
    ]}
  >
    <slot>{title}</slot>
  </h1>
  <div class="pagehead-rule mt-4" aria-hidden="true"></div>
  <slot name="description">
    {
      description && (
        <p class:list={[styles.description, centered && styles['description-centered']]}>
          {description}
        </p>
      )
    }
  </slot>
</div>
