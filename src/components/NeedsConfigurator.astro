---
import { portalBase, portalModules } from '../content/portalModules';
import styles from './NeedsConfigurator.module.css';
---

<div data-needs-configurator class:list={['surface-raised', styles.configurator]}>
  <h2 id="portal-heading" class="text-step-2 font-bold">Sitio web profesional por módulos</h2>
  <p class="mt-2 text-sm text-muted">
    Base: {portalBase.delivery}. Plazo orientativo: {portalBase.timeline}. Los módulos y sus
    dependencias se revisan antes de definir el calendario y las condiciones en la propuesta.
  </p>

  <section class={styles.base} data-portal-base aria-labelledby="portal-base-title">
    <h3 id="portal-base-title" class={styles['zone-title']}>{portalBase.title}</h3>
    <p class="mt-1 text-sm text-muted">{portalBase.short}</p>
    <p class="mt-1 text-sm text-muted">{portalBase.scope}</p>
  </section>

  <section class={styles.options} data-portal-options aria-labelledby="portal-options-title">
    <h3 id="portal-options-title" class={styles['zone-title']}>Módulos opcionales</h3>
    <ul class={styles['module-list']} data-needs-list>
      {
        portalModules.map((module) => (
          <li class="text-sm">
            <label class={styles.module} for={`mod-${module.id}`}>
              <input
                id={`mod-${module.id}`}
                type="checkbox"
                value={module.id}
                data-module={module.id}
                class="checkbox checkbox-primary mt-0.5 h-6 w-6"
                aria-describedby="needs-summary"
              />
              <span class={styles['module-content']}>
                <strong>{module.title}</strong>
                <span class="block text-muted">{module.short}</span>
                <span class="block text-muted">{module.scope}</span>
                <span class="block text-muted">{module.timeline}</span>
                {module.dependencies.map((dependency) => (
                  <span class="block text-xs text-muted">Requisito: {dependency}</span>
                ))}
              </span>
            </label>
          </li>
        ))
      }
    </ul>
  </section>

  <div
    id="needs-summary"
    class={styles.summary}
    aria-live="polite"
    aria-atomic="true"
    data-selected-modules
  >
    <strong>Necesidades seleccionadas</strong>
    <p class="mt-2 text-muted" data-needs-empty>
      Todavía no hay módulos seleccionados. La propuesta puede partir solo de la base.
    </p>
    <ul class="mt-2 list-disc pl-5 text-muted" data-needs-selected hidden></ul>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <a
      href="/contacto/?motivo=propuestaComercial&origen=servicios"
      data-needs-cta
      class="btn focus-ring inline-flex min-h-11 items-center justify-center gap-2 rounded bg-primary px-6 py-3 font-medium text-ink transition-colors hover:bg-primaryHover"
    >
      Solicitar propuesta
    </a>
    <a
      href="/contacto/?motivo=informacionCliente"
      class="focus-ring inline-flex min-h-6 items-center rounded text-sm font-medium text-muted underline decoration-dotted underline-offset-4 hover:text-primary"
    >
      Solicitar información sin seleccionar módulos
    </a>
  </div>
</div>

<script>
  import '../scripts/needsConfigurator';
</script>
